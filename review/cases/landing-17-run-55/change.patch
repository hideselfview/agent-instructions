+    );
+    let returned = "impl Owner { pub fn open(connection: &Connection) -> Connection { todo!() } }";
+    assert_eq!(
+        leaks_under(&listed, PATH, returned),
+        findings(PATH, &["Owner::open returns retained dependency Connection"])
+    );
