diff --git a/bae-import/src/tables/catalog_apply_steps.rs b/bae-import/src/tables/catalog_apply_steps.rs
new file mode 100644
index 0000000000..8dd4f737da
--- /dev/null
+++ b/bae-import/src/tables/catalog_apply_steps.rs
@@ -0,0 +1,109 @@
+//! The network read each apply of a catalog release waits on now
+//! (`import_catalog_apply_step`), by the apply's id: written as the read
+//! starts, deleted as it ends, and read by the screen that shows the apply.
+//! No apply outlives the process, so the table is emptied as the library
+//! opens. Its table is `catalog_apply_steps.sql`.
+
+use super::*;
+use crate::{CatalogApplyId, CatalogApplyStep};
+
+/// The catalog apply steps' part of the library's schema.
+pub(super) const SCHEMA: bae_store::SchemaPart =
+    bae_store::SchemaPart::new(&[include_str!("catalog_apply_steps.sql")]);
+
+/// The stored `step` value of `step`, and its catalog.
+fn step_columns(step: CatalogApplyStep) -> (&'static str, Catalog) {
+    match step {
+        CatalogApplyStep::ReadingRelease(catalog) => ("reading_release", catalog),
+        CatalogApplyStep::FetchingCover(catalog) => ("fetching_cover", catalog),
+    }
+}
+
+/// The read `apply` waits on now, or `None` while it waits on none.
+fn load_step_on(
+    sql: &SqlReadContext<'_>,
+    apply: &CatalogApplyId,
+) -> Result<Option<CatalogApplyStep>, DbError> {
+    let columns = sql
+        .query_row(
+            "SELECT step, catalog FROM import_catalog_apply_step WHERE apply_id = ?",
+            [apply.as_str()],
+            |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),
+        )
+        .optional()?;
+    let Some((step, catalog)) = columns else {
+        return Ok(None);
+    };
+    let broken = |what: &str| {
+        DbError::unreadable(format!("import_catalog_apply_step of {}", apply.as_str()), what)
+    };
+    let catalog = Catalog::from_str(&catalog).map_err(|_unknown| broken(&catalog))?;
+    match step.as_str() {
+        "reading_release" => Ok(Some(CatalogApplyStep::ReadingRelease(catalog))),
+        "fetching_cover" => Ok(Some(CatalogApplyStep::FetchingCover(catalog))),
+        other => Err(broken(other)),
+    }
+}
+
+impl ImportTables {
+    /// Write that `apply` waits on `step` now.
+    pub(crate) async fn start_catalog_apply_step(
+        &self,
+        apply: &CatalogApplyId,
+        step: CatalogApplyStep,
+    ) -> Result<(), DbError> {
+        let apply = apply.clone();
+        let (step, catalog) = step_columns(step);
+        self.store
+            .call(move |sql| {
+                sql.execute(
+                    "INSERT INTO import_catalog_apply_step (apply_id, step, catalog) \
+                     VALUES (?, ?, ?)",
+                    params![apply.as_str(), step, catalog.as_str()],
+                )?;
+                Ok(())
+            })
+            .await
+    }
+
+    /// Write that `apply` waits on no read now.
+    pub(crate) async fn end_catalog_apply_step(
+        &self,
+        apply: &CatalogApplyId,
+    ) -> Result<(), DbError> {
+        let apply = apply.clone();
+        self.store
+            .call(move |sql| {
+                sql.execute(
+                    "DELETE FROM import_catalog_apply_step WHERE apply_id = ?",
+                    [apply.as_str()],
+                )?;
+                Ok(())
+            })
+            .await
+    }
+
+    /// Delete every apply's step: what the library opens with, since no
+    /// apply outlives the process that wrote its step.
+    pub(crate) async fn clear_catalog_apply_steps(&self) -> Result<(), DbError> {
+        self.store
+            .call(|sql| {
+                sql.execute("DELETE FROM import_catalog_apply_step", [])?;
+                Ok(())
+            })
+            .await
+    }
+
+    /// The read `apply` waits on, live: `None` while it waits on none.
+    pub(crate) fn subscribe_catalog_apply_step(
+        &self,
+        apply: &CatalogApplyId,
+    ) -> coven::LiveQuery<Option<CatalogApplyStep>, DbError> {
+        let apply = apply.clone();
+        self.store.subscribe(move |sql| load_step_on(&sql, &apply))
+    }
+}
+
+#[cfg(test)]
+#[path = "catalog_apply_steps_tests.rs"]
+mod tests;
diff --git a/bae-import/src/tables/catalog_apply_steps.sql b/bae-import/src/tables/catalog_apply_steps.sql
new file mode 100644
index 0000000000..545dae7b1d
--- /dev/null
+++ b/bae-import/src/tables/catalog_apply_steps.sql
@@ -0,0 +1,12 @@
+-- The network read each apply of a catalog release waits on now, by the id
+-- the app's apply was given: an import pick's or the release editor's. The
+-- apply writes the row as the read starts and deletes it as the read ends,
+-- so a row exists only while its read runs. No apply outlives the process,
+-- so the table is emptied as the library opens.
+CREATE TABLE IF NOT EXISTS import_catalog_apply_step (
+    apply_id TEXT PRIMARY KEY,
+    step     TEXT NOT NULL CHECK (step IN ('reading_release', 'fetching_cover')),
+    catalog  TEXT NOT NULL CHECK (catalog IN (
+        'musicbrainz', 'discogs', 'allmusic', 'apple_music', 'bandcamp', 'deezer',
+        'genius', 'musik_sammler', 'rateyourmusic', 'spotify', 'wikidata'))
+) STRICT;
diff --git a/bae-import/src/tables/catalog_apply_steps_tests.rs b/bae-import/src/tables/catalog_apply_steps_tests.rs
new file mode 100644
index 0000000000..dee826039e
--- /dev/null
+++ b/bae-import/src/tables/catalog_apply_steps_tests.rs
@@ -0,0 +1,100 @@
+//! Each apply's step row, as the apply's own steps write it.
+
+use bae_catalogs::catalog::Catalog;
+use bae_store::test_fixtures::empty_db;
+use bae_util::test_channels::HANG_GUARD;
+
+use crate::tables::ImportTables;
+use crate::{CatalogApplyId, CatalogApplyStep, CatalogApplySteps};
+
+type StepQuery = coven::LiveQuery<Option<CatalogApplyStep>, bae_store::DbError>;
+
+/// The steps of the apply `id` names, over `tables`.
+fn shown(id: &CatalogApplyId, tables: &ImportTables) -> CatalogApplySteps {
+    CatalogApplySteps::shown(
+        id.clone(),
+        tables.clone(),
+        bae_diagnostics::Diagnostics::noop(),
+        tokio::runtime::Handle::current(),
+    )
+}
+
+/// Pull from `query` until it delivers `wanted`.
+async fn step_until(query: &mut StepQuery, wanted: Option<CatalogApplyStep>) {
+    tokio::time::timeout(HANG_GUARD, async {
+        loop {
+            let step = query.next().await.expect("the query stays open").expect("the query reads");
+            if step == wanted {
+                return;
+            }
+        }
+    })
+    .await
+    .unwrap_or_else(|_| panic!("the apply's row never held {wanted:?}"));
+}
+
+/// The apply's row holds a read's step from when the read starts until it
+/// ends, and holds nothing between reads.
+#[tokio::test]
+async fn the_row_holds_each_step_while_its_read_runs() {
+    let (db, _tmp) = empty_db(crate::TEST_SCHEMA).await;
+    let tables = ImportTables::new(db);
+    let apply = CatalogApplyId::new(&coven::UuidIds);
+    let steps = shown(&apply, &tables);
+    let mut query = tables.subscribe_catalog_apply_step(&apply);
+    step_until(&mut query, None).await;
+
+    let reading = CatalogApplyStep::ReadingRelease(Catalog::Discogs);
+    let (finish, finished) = tokio::sync::oneshot::channel::<()>();
+    let watch = async {
+        step_until(&mut query, Some(reading)).await;
+        finish.send(()).expect("the read waits");
+    };
+    let (read, ()) = tokio::join!(steps.during(reading, finished), watch);
+    read.expect("the read ends when it is told to");
+    step_until(&mut query, None).await;
+
+    let cover = CatalogApplyStep::FetchingCover(Catalog::MusicBrainz);
+    let fetched = steps.during(cover, async { "the cover" }).await;
+    assert_eq!(fetched, "the cover");
+    // The query may never see a step this short, so a new one reads the row
+    // as the step left it.
+    let mut after = tables.subscribe_catalog_apply_step(&apply);
+    step_until(&mut after, None).await;
+}
+
+/// An apply dropped while a read runs leaves no step in its row.
+#[tokio::test]
+async fn a_dropped_apply_leaves_no_step() {
+    let (db, _tmp) = empty_db(crate::TEST_SCHEMA).await;
+    let tables = ImportTables::new(db);
+    let apply = CatalogApplyId::new(&coven::UuidIds);
+    let steps = shown(&apply, &tables);
+    let mut query = tables.subscribe_catalog_apply_step(&apply);
+    let reading = CatalogApplyStep::ReadingRelease(Catalog::MusicBrainz);
+
+    let read = steps.during(reading, std::future::pending::<()>());
+    tokio::select! {
+        () = read => unreachable!("the read never ends"),
+        () = step_until(&mut query, Some(reading)) => {}
+    }
+    step_until(&mut query, None).await;
+}
+
+/// The library opens with no apply's step: no apply outlives the process
+/// that wrote it.
+#[tokio::test]
+async fn the_open_empties_every_step() {
+    let (db, _tmp) = empty_db(crate::TEST_SCHEMA).await;
+    let tables = ImportTables::new(db);
+    let apply = CatalogApplyId::new(&coven::UuidIds);
+    let mut query = tables.subscribe_catalog_apply_step(&apply);
+    // A step whose apply neither ended nor was dropped, as a process that
+    // ended mid-step leaves it.
+    let reading = CatalogApplyStep::FetchingCover(Catalog::Bandcamp);
+    tables.start_catalog_apply_step(&apply, reading).await.unwrap();
+    step_until(&mut query, Some(reading)).await;
+
+    tables.clear_catalog_apply_steps().await.unwrap();
+    step_until(&mut query, None).await;
+}
