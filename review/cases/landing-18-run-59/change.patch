diff --git a/crates/coven-database/src/block_on.rs b/crates/coven-database/src/block_on.rs
new file mode 100644
index 000000000..2720aa706
--- /dev/null
+++ b/crates/coven-database/src/block_on.rs
@@ -0,0 +1,36 @@
+//! Waiting for a future on a thread, with no runtime.
+
+use std::{
+    future::Future,
+    pin::pin,
+    sync::Arc,
+    task::{Context, Poll, Wake, Waker},
+    thread::{self, Thread},
+};
+
+/// Wakes the thread that `block_on` parks.
+struct Unpark(Thread);
+
+impl Wake for Unpark {
+    fn wake(self: Arc<Self>) {
+        self.0.unpark();
+    }
+}
+
+/// Poll `future` on this thread, parking it between wake-ups. It needs no
+/// runtime.
+pub(crate) fn block_on<F: Future>(future: F) -> F::Output {
+    let waker = Waker::from(Arc::new(Unpark(thread::current())));
+    let mut context = Context::from_waker(&waker);
+    let mut future = pin!(future);
+    loop {
+        match future.as_mut().poll(&mut context) {
+            Poll::Ready(output) => return output,
+            Poll::Pending => thread::park(),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "block_on_tests.rs"]
+mod tests;
