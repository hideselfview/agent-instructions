diff --git a/crates/coven-database/src/live_results.rs b/crates/coven-database/src/live_results.rs
new file mode 100644
index 000000000..956b58e4a
--- /dev/null
+++ b/crates/coven-database/src/live_results.rs
@@ -0,0 +1,59 @@
+//! A live query's results for code on an async executor.
+
+use crate::{DbError, LiveQuery};
+use coven_foundation::locks::{into_unpoisoned, lock_unpoisoned};
+use coven_foundation::task::{blocking_completing, CarriesBug};
+use std::sync::{Arc, Mutex};
+
+/// The query's next result, with the query to ask again: it waits for
+/// `changed()` on the executor, runs `run_changed` on tokio's blocking pool,
+/// and waits again when a write-caused result equals the last, so no pool
+/// thread waits. `None` once the query has ended (E15). A pool that has begun
+/// shutting down answers `Some(Err(DbError::Shutdown))`, and a panic outside
+/// the run itself answers `Some(Err(DbError::Bug))`.
+///
+/// Dropping this future loses the query, since the pool's thread holds it; a
+/// run in flight ends on its own thread, and a bug in its result goes to the
+/// store's bug sink (E15).
+pub async fn next_result<T, E>(
+    mut query: LiveQuery<T, E>,
+) -> (LiveQuery<T, E>, Option<Result<T, E>>)
+where
+    T: Clone + PartialEq + Send + 'static,
+    E: From<DbError> + CarriesBug + Send + 'static,
+{
+    loop {
+        if query.has_ended() {
+            return (query, None);
+        }
+        query.changed().await;
+        let bugs = query.bugs().clone();
+        // The slot keeps the query when the pool drops the work unstarted or
+        // the work panics, so either answers with the query.
+        let slot = Arc::new(Mutex::new(query));
+        let held = Arc::clone(&slot);
+        let result = blocking_completing(
+            "live query",
+            bugs,
+            crate::commit_task::bind(move || match lock_unpoisoned(&held).run_changed() {
+                None => Ok(None),
+                Some(result) => result.map(Some),
+            }),
+        )
+        .await;
+        query = match Arc::try_unwrap(slot) {
+            Ok(slot) => into_unpoisoned(slot),
+            Err(_) => unreachable!("the pool has dropped or ended the work"),
+        };
+        match result {
+            Ok(Ok(None)) => {}
+            Ok(Ok(Some(value))) => return (query, Some(Ok(value))),
+            Ok(Err(error)) => return (query, Some(Err(error))),
+            Err(failed) => return (query, Some(Err(E::from(DbError::from(failed))))),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "live_results_tests.rs"]
+mod tests;
diff --git a/crates/coven-database/src/live_results_tests.rs b/crates/coven-database/src/live_results_tests.rs
new file mode 100644
index 000000000..4698b5075
--- /dev/null
+++ b/crates/coven-database/src/live_results_tests.rs
@@ -0,0 +1,46 @@
+use crate::DbError;
+use crate::{
+    test_utils::{notes_migrations, notes_tables},
+    tests::TestStore,
+};
+
+/// A skipped write leaves no blocking-pool thread waiting: with one blocking
+/// thread, other blocking work still runs while `next_result` waits for the
+/// change after the skip.
+#[test]
+fn next_result_after_a_skipped_write_waits_without_holding_a_pool_thread() {
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .max_blocking_threads(1)
+        .enable_all()
+        .build()
+        .unwrap();
+    runtime.block_on(async {
+        let store = TestStore::new();
+        let db = store.builder(notes_tables(), notes_migrations()).open().await.unwrap();
+        db.commit_writer(|sql| sql.batch("INSERT INTO notes VALUES ('a','Plan','')").unwrap());
+        let (ran, mut runs) = tokio::sync::mpsc::unbounded_channel();
+        let query: crate::LiveQuery<_, DbError> = db.subscribe(move |sql| {
+            ran.send(()).unwrap();
+            Ok(sql.query_row("SELECT count(*) > 0 FROM notes", [], |r| r.get::<_, bool>(0))?)
+        });
+        let (query, first) = crate::next_result(query).await;
+        assert!(first.unwrap().unwrap());
+        runs.recv().await.unwrap();
+        let answer = tokio::spawn(crate::next_result(query));
+        db.commit_writer(|sql| sql.batch("INSERT INTO notes VALUES ('b','Plan','')").unwrap());
+        // The run that finds an equal result has started.
+        runs.recv().await.unwrap();
+        // Blocking work queued behind that run starts once it ends, which a
+        // parked thread would prevent.
+        coven_foundation::clock::within(tokio::task::spawn_blocking(|| ()))
+            .await
+            .expect("the pool's one thread is free")
+            .unwrap();
+        assert!(!answer.is_finished(), "an equal result was returned");
+        db.commit_writer(|sql| sql.batch("DELETE FROM notes").unwrap());
+        let (_query, second) = answer.await.unwrap();
+        assert!(!second.unwrap().unwrap());
+        db.close().await.unwrap();
+    });
+}
