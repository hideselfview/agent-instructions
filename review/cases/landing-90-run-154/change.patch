From 9b00ef503a0ba07b8fd1425fb5108e8e4193bd3b Mon Sep 17 00:00:00 2001
From: Dmitry Minkovsky <dminkovsky@gmail.com>
Date: Mon, 16 Nov 2026 15:04:47 -0500
Subject: [PATCH] Draw the seek fill as core sends it, with no clamping

Core already sends the playing track's fill from 0 to 1, holding it at 1
past the stored length. The Mac seek slider worked out its own fraction
from its value and range, and the bar drawing clamped every fraction it
drew. The slider now keeps a range of 0 to 1 itself and draws its value,
and the drawing draws each fraction as it comes. Core's fill no longer
clamps either: a fill outside 0 to 1 fails a debug assertion there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bae/Views/Components/ProgressTrack.swift  |  8 +++----
 .../bae/Views/Components/SeekBarNSView.swift  |  2 --
 .../bae/bae/Views/Components/SeekSlider.swift | 24 +++++++++++++------
 bae-playback/src/timeline.rs                  | 12 ++++++----
 bae-playback/src/timeline_tests.rs            | 10 ++++++++
 spec/bae.md                                   |  8 ++++---
 6 files changed, 44 insertions(+), 20 deletions(-)

diff --git a/bae-macos/bae/bae/Views/Components/ProgressTrack.swift b/bae-macos/bae/bae/Views/Components/ProgressTrack.swift
index 80af739828..3fb9706b4c 100644
--- a/bae-macos/bae/bae/Views/Components/ProgressTrack.swift
+++ b/bae-macos/bae/bae/Views/Components/ProgressTrack.swift
@@ -41,15 +41,15 @@ enum ProgressTrackDrawing {
     }
 
     /// An accent fill to `fraction` of the track, never narrower than its
-    /// height; none at zero.
+    /// height; none at zero. The fill draws `fraction` as it comes, with no
+    /// clamping: a fraction outside 0 to 1 is a bug in the code that made it.
     static func drawFill(in bar: NSRect, fraction: Double, accent: NSColor) {
         let radius = bar.height / 2
-        let clamped = CGFloat(min(max(fraction, 0), 1))
-        guard clamped > 0 else {
+        guard fraction > 0 else {
             return
         }
         var fill = bar
-        fill.size.width = max(bar.width * clamped, bar.height)
+        fill.size.width = max(bar.width * CGFloat(fraction), bar.height)
         let fillPath = NSBezierPath(
             roundedRect: fill,
             xRadius: radius,
