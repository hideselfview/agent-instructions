         slider.setAccessibilityLabel(String(localized: "Position"))
         slider.translatesAutoresizingMaskIntoConstraints = false
diff --git a/bae-macos/bae/bae/Views/Components/SeekSlider.swift b/bae-macos/bae/bae/Views/Components/SeekSlider.swift
index 87edc7de59..bc0c65706a 100644
--- a/bae-macos/bae/bae/Views/Components/SeekSlider.swift
+++ b/bae-macos/bae/bae/Views/Components/SeekSlider.swift
@@ -3,7 +3,9 @@ import BaeKit
 
 /// NSSlider subclass that reports drag start/end and jumps to the clicked
 /// position. `mouseDown` blocks until the user releases, so `isDragging` is
-/// accurate. Used by `SeekBarNSView`.
+/// accurate. Used by `SeekBarNSView`. Its value is the fill core sends, from
+/// 0 to 1, or where the person drags it to, so the cell draws the value as
+/// it is.
 class SeekSlider: NSSlider {
     var accent: NSColor = .controlAccentColor {
         didSet { needsDisplay = true }
@@ -25,6 +27,17 @@ class SeekSlider: NSSlider {
         set {}
     }
 
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        minValue = 0
+        maxValue = 1
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError()
+    }
+
     override func mouseDown(with event: NSEvent) {
         // Disabled while the track's length is unknown: there is no position for
         // a click to seek to.
@@ -40,9 +53,9 @@ class SeekSlider: NSSlider {
             if !knobRect.contains(point) {
                 let barRect = cell.barRect(flipped: isFlipped)
                 if barRect.width > 0 {
+                    // A click past either end of the bar seeks to that end.
                     let ratio = Double((point.x - barRect.minX) / barRect.width)
-                    let value = ratio * (maxValue - minValue) + minValue
-                    doubleValue = max(minValue, min(maxValue, value))
+                    doubleValue = max(0, min(1, ratio))
                 }
             }
         }
@@ -73,9 +86,6 @@ final class SlimSeekSliderCell: NSSliderCell {
         bar.origin.y = rect.midY - trackHeight / 2
         bar.size.height = trackHeight
 
-        let span = maxValue - minValue
-        let fraction =
-            span > 0 ? min(max((doubleValue - minValue) / span, 0), 1) : 0
         guard let slider = controlView as? SeekSlider else {
             preconditionFailure("SlimSeekSliderCell belongs to SeekSlider")
         }
@@ -89,7 +99,7 @@ final class SlimSeekSliderCell: NSSliderCell {
         )
         ProgressTrackDrawing.drawFill(
             in: bar,
-            fraction: fraction,
+            fraction: doubleValue,
             accent: slider.accent
         )
     }
diff --git a/bae-playback/src/timeline.rs b/bae-playback/src/timeline.rs
index ff963cb917..5aed26a777 100644
--- a/bae-playback/src/timeline.rs
+++ b/bae-playback/src/timeline.rs
@@ -125,15 +125,19 @@ impl TrackTimeline {
         StreamPosition::from_millis(u64::try_from(ms.max(0)).unwrap_or(u64::MAX))
     }
 
-    /// The seek bar's fill (0.0–1.0) at `position`: zero through the pregap,
-    /// one at the track's end. Zero throughout when the length is unknown or
-    /// zero, since there is no end to fill toward.
+    /// The seek bar's fill, from 0 to 1, at `position`: zero through the
+    /// pregap, one at the track's end and past it, where the track's time
+    /// holds at its length. Zero throughout when the length is unknown or
+    /// zero, since there is no end to fill toward. The views draw the fill as
+    /// it comes, so a fill outside 0 to 1 is a bug here.
     pub fn progress(self, position: StreamPosition) -> f64 {
         let Some(duration_ms) = self.duration_ms().filter(|ms| *ms > 0) else {
             return 0.0;
         };
         let time = self.track_time(position).as_millis();
-        (time.max(0) as f64 / duration_ms as f64).clamp(0.0, 1.0)
+        let fill = time.max(0) as f64 / duration_ms as f64;
+        debug_assert!((0.0..=1.0).contains(&fill), "the seek bar's fill {fill} is outside 0 to 1");
+        fill
     }
 
     /// The stream position a seek bar fill points at — the inverse of
diff --git a/bae-playback/src/timeline_tests.rs b/bae-playback/src/timeline_tests.rs
index 22e248090c..0c582e46b1 100644
--- a/bae-playback/src/timeline_tests.rs
+++ b/bae-playback/src/timeline_tests.rs
@@ -44,6 +44,16 @@ fn progress_starts_after_pregap() {
     assert_eq!(t.progress(at(12_000)), 1.0);
 }
 
+/// Decoded audio can run past the declared end. The track's time holds at
+/// its length there, so the fill holds at 1.0 and never passes it: the views
+/// draw the fill as core sends it.
+#[test]
+fn progress_holds_at_one_past_the_declared_end() {
+    let t = timeline(10_000, 2000);
+    assert_eq!(t.progress(at(12_001)), 1.0);
+    assert_eq!(t.progress(at(40_000)), 1.0);
+}
+
 #[test]
 fn progress_zero_duration() {
     assert_eq!(timeline(0, 0).progress(at(0)), 0.0);
