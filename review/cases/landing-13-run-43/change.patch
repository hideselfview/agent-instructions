+    let mut initial = migrations();
+    initial.truncate(1);
+    store.builder(vec![], initial).open().await.unwrap().close().await.unwrap();
+    for _ in 0..2 {
+        let db = store.builder(vec![], migrations()).open().await.unwrap();
+        let error = db
