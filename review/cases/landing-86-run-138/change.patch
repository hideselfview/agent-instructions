+        assert_eq!(session_up_next(&db, 3).await, every[..3], "shuffled: {shuffled}");
+        assert_eq!(session_up_next(&db, 1).await, every[..1], "shuffled: {shuffled}");
+        assert!(session_up_next(&db, 0).await.is_empty());
+    }
+}
