     public private(set) var error: DisplayError?
 
     @ObservationIgnored
@@ -78,8 +81,14 @@ public final class ArtistSearchResults {
             return
         }
         list?.cancel()
+        if let failure = next.initialLoadError {
+            next.cancel()
+            list = nil
+            error = failure
+            return
+        }
         list = next
-        error = next.initialLoadError
+        error = nil
