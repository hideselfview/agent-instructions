#!/bin/bash
# builds: this machine's build-output layout for git checkouts.
#
# Every checkout of a repo (the main checkout and its side worktrees side-1,
# side-2, ...) owns one build root at a fixed path on the build volume:
#
#   /Volumes/Builds/<repo>/<checkout>/        checkout = main | side-N
#
# The repo lists its build-output paths and their size caps in `.build-dirs`
# at its root. Each listed path is a symlink in the checkout to the same path
# under the checkout's build root (target -> /Volumes/Builds/bae/main/target).
#
# The path a tool sees never changes: cargo, xcodebuild, Gradle, dotnet and
# lake always write through `<checkout>/<path>`, so sccache keys and cargo
# fingerprints stay valid however often the folder behind the link is deleted
# and recreated. Two checkouts never share a folder, so their builds never
# wait on each other's locks.
#
# Commands:
#   builds setup [<checkout>]   link the checkout's build paths, recreate any
#                               missing folder, apply the caps to it, then make
#                               sure the volume has the free-space floor.
#                               The repo's hooks and build scripts run this.
#   builds new [<repo>] [-b <branch>]
#                               add the next free side-N worktree from
#                               origin/main, link it, run its post-checkout
#   builds retire <checkout>    remove a side worktree and its build root
#   builds app-checkout <checkout>
#                               record the side worktree as its repo's app
#                               checkout, in /Volumes/Builds/<repo>/app-checkout
#   builds status               every build root: size per folder vs cap
#   builds prune [--dry-run] [--idle <minutes>]
#                               apply the caps everywhere; delete roots whose
#                               checkout is gone. --idle also deletes every
#                               folder nothing wrote to for that long (how
#                               reclaim-disk frees the build volume)
#   builds install              put `builds` on PATH, write the sccache config,
#                               run the sccache server under launchd
#
# By default a side worktree builds host Rust only, and a repo with app builds
# keeps them warm in main and in one side worktree, its app checkout, which
# agents take turns in by holding /Volumes/Builds/<repo>/app.lock; see
# principles/worktree-build-priming.md. Nothing here enforces who builds what:
# the caps bound whatever a checkout builds, and the floor below bounds every
# checkout but main and the app checkout.
#
# A folder over its cap is deleted whole and recreated empty; the next build
# repopulates it, mostly from sccache. A folder that any process holds a file
# open in is never deleted.
#
# Caps bound each folder, not the volume: a checkout with every platform built
# is 45-52 GB, and the build volume shares its APFS pool with the main disk.
# So `setup` also keeps a free-space floor: under it, it deletes whole idle
# folders across every checkout but main and the app checkout, whose builds
# stay warm on purpose, least recently written first, and fails, naming the
# biggest folders, if it still can't reach the floor, rather than let the
# build run out of space halfway.

set -euo pipefail

# A git hook runs this with its own repository's GIT_DIR, GIT_INDEX_FILE and
# the rest exported. Every git call here names the checkout it asks about with
# -C, so drop them: kept, git answers for the hook's repository about every
# other checkout, and each of another repo's build roots reads as orphaned.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

ROOT="${BUILDS_ROOT:-/Volumes/Builds}"
TRASH="$ROOT/.trash"
MANIFEST=.build-dirs
# The free space a build may need. bae's iOS build is the largest single
# platform build (target-ios 12.2G + bae-ios/.build 4.9G fresh); another
# checkout building macOS at the same time (bridge 7.4G + DerivedData 5.2G) is
# the headroom.
FLOOR_KIB=$(( ${BUILDS_FREE_FLOOR_GIB:-30} * 1024 * 1024 ))
# A folder written this recently may belong to a build between two of its
# steps, when it holds no lock or open file; the floor never deletes it.
FLOOR_IDLE_MINUTES=30
# This script's own path, through the ~/.local/bin link `install` makes.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    link_target="$(readlink "$self")"
    case "$link_target" in
        /*) self="$link_target" ;;
        *) self="$(dirname "$self")/$link_target" ;;
    esac
done
SELF="$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")"

die() { echo "builds: $*" >&2; exit 1; }
note() { echo "builds: $*" >&2; }

# ── Checkout identity ───────────────────────────────────────────────────────

checkout_top() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null \
        || die "$1 is not inside a git checkout"
}

# The main checkout: the directory holding the common .git.
main_checkout() {
    local common
    common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)"
    dirname "$common"
}

repo_name() { basename "$(main_checkout "$1")"; }

checkout_name() {
    local top="$1"
    if [ "$top" = "$(main_checkout "$top")" ]; then
        echo main
    else
        basename "$top"
    fi
}

build_root() { echo "$ROOT/$(repo_name "$1")/$(checkout_name "$1")"; }

# The file naming <repo>'s app checkout, the one side worktree that keeps app
# builds warm beside main; `builds app-checkout` writes it. It sits beside the
# app checkout's lock, /Volumes/Builds/<repo>/app.lock.
app_checkout_file() { echo "$ROOT/$1/app-checkout"; }

# Prints <repo>'s app checkout name (side-N), or nothing when none is recorded.
app_checkout_of() {
    local file
    file="$(app_checkout_file "$1")"
    [ -f "$file" ] && cat "$file"
    return 0
}

# Is <root> (/Volumes/Builds/<repo>/<checkout>) main's or the app checkout's?
# Their builds stay warm on purpose: the person installs from main and tests
# agents' app builds in the app checkout. The free-space floor never deletes
# their folders; the caps still apply to them.
keeps_warm() {
    local checkout repo
    checkout="$(basename "$1")"
    repo="$(basename "$(dirname "$1")")"
    [ "$checkout" = main ] || [ "$checkout" = "$(app_checkout_of "$repo")" ]
}

# ── Manifest ────────────────────────────────────────────────────────────────

# Prints "<path> <cap-in-KiB>" per listed path; fails on a malformed line.
manifest_entries() {
    local file="$1/$MANIFEST" path cap rest kib
    [ -f "$file" ] || return 0
    while read -r path cap rest; do
        case "$path" in ''|'#'*) continue ;; esac
        [ -z "$rest" ] || die "$file: extra field after '$path $cap'"
        case "$path" in
            /*|..|../*|*/..|*/../*) die "$file: '$path' must be inside the checkout" ;;
        esac
        case "$cap" in
            *[0-9]G) kib=$(( ${cap%G} * 1024 * 1024 )) ;;
            *[0-9]M) kib=$(( ${cap%M} * 1024 )) ;;
            *) die "$file: '$path' needs a cap like 20G or 500M, got '$cap'" ;;
        esac
        echo "$path $kib"
    done < "$file"
}

has_manifest() { [ -f "$1/$MANIFEST" ]; }

require_volume() {
    [ -d "$ROOT" ] || die "build volume $ROOT is not mounted"
}

# ── Ownership of old folders during migration ──────────────────────────────

worktrees_of() {
    git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p'
}

absolute_link_target() {
    local link="$1" target
    target="$(readlink "$link")"
    case "$target" in
        /*) echo "$target" ;;
        *) echo "$(cd "$(dirname "$link")" && pwd -P)/$target" ;;
    esac
}

# May checkout <top> delete <folder>, the folder its link points at today?
# Never a folder inside another live checkout's build root. A folder from an
# older layout that another checkout's link also points at is the main
# checkout's to delete; a side checkout leaves it and starts its own.
may_delete() {
    local folder="$1" top="$2" repo wt path _kib owner
    repo="$(repo_name "$top")"
    case "$folder" in
        "$ROOT/$repo"/*/*)
            owner="${folder#"$ROOT/$repo"/}"
            owner="${owner%%/*}"
            if [ -f "$ROOT/$repo/$owner/.checkout" ]; then
                wt="$(cat "$ROOT/$repo/$owner/.checkout")"
                if [ "$wt" != "$top" ] && checkout_is_live "$ROOT/$repo/$owner"; then
                    return 1
                fi
            fi
            ;;
    esac
    [ "$(checkout_name "$top")" = main ] && return 0
    while IFS= read -r wt; do
        [ "$wt" = "$top" ] && continue
        while read -r path _kib; do
            if [ -L "$wt/$path" ] && [ "$(absolute_link_target "$wt/$path")" = "$folder" ]; then
                return 1
            fi
        done < <(manifest_entries "$top")
    done < <(worktrees_of "$top")
    return 0
}

# ── Linking ─────────────────────────────────────────────────────────────────

same_volume() { [ "$(stat -f %d "$1")" = "$(stat -f %d "$2")" ]; }

# Deletes <dir>, a build folder from an older layout: through evict on the
# build volume, which refuses while a build uses it; elsewhere renamed aside
# and removed in the background. Returns 1, deleting nothing, when in use.
discard() {
    local dir="$1" aside
    if same_volume "$dir" "$ROOT"; then
        evict "$dir" 0 || return 1
    else
        aside="$(mktemp -d "$(dirname "$dir")/.builds-deleting.XXXXXX")"
        mv "$dir" "$aside/"
        nohup rm -rf "$aside" >/dev/null 2>&1 &
    fi
}

# Makes <link> a symlink to <dest> and makes sure <dest> exists. A folder at
# any other place — behind a link to an older location (when may_delete says
# it is this checkout's), or a real directory a tool left before the link
# existed — is deleted, never moved: Xcode's DerivedData records its own
# absolute path, so a moved one fails to find its packages. The next build
# refills <dest>, cargo mostly from sccache.
place() {
    local link="$1" dest="$2" top="$3" current
    if [ -L "$link" ]; then
        current="$(absolute_link_target "$link")"
        if [ "$current" != "$dest" ]; then
            if [ -d "$current" ] && may_delete "$current" "$top"; then
                discard "$current" \
                    || die "a build is using $current; run builds setup again once it ends"
                note "deleted $current, a folder from an older layout"
            fi
            ln -sfn "$dest" "$link"
            note "linked ${link#"$top"/} -> $dest"
        fi
    elif [ -e "$link" ]; then
        discard "$link" \
            || die "a build is using ${link#"$top"/}; run builds setup again once it ends"
        note "deleted ${link#"$top"/}, a real directory; it builds into $dest now"
        ln -s "$dest" "$link"
        note "linked ${link#"$top"/} -> $dest"
    else
        mkdir -p "$(dirname "$link")"
        ln -s "$dest" "$link"
        note "linked ${link#"$top"/} -> $dest"
    fi
    # A link whose folder was deleted breaks every tool that writes through it
    # (cargo os error 20, xcodebuild rc 74, Gradle's file hash cache, dotnet
    # MSB3021, lake error 17); recreating the folder is all any of them need.
    mkdir -p "$dest"
}

cmd_setup() {
    local top root path kib
    top="$(checkout_top "${1:-.}")"
    has_manifest "$top" || { note "$top has no $MANIFEST; nothing to link"; return 0; }
    require_volume
    root="$(build_root "$top")"
    mkdir -p "$root"
    printf '%s\n' "$top" > "$root/.checkout"
    while read -r path kib; do
        place "$top/$path" "$root/$path" "$top"
        if [ "$path" = target ] && [ -n "${CARGO_TARGET_DIR:-}" ]; then
            note "CARGO_TARGET_DIR=$CARGO_TARGET_DIR overrides $top/target for cargo run here"
        fi
    done < <(manifest_entries "$top")
    prune_root "$root" "$top" 0
    keep_floor
}

# ── Pruning ─────────────────────────────────────────────────────────────────

kib_of() { du -sk "$1" 2>/dev/null | cut -f1; }

human() {
    local kib="$1"
    if [ "$kib" -ge 1048576 ]; then
        awk -v k="$kib" 'BEGIN { printf "%.1fG", k / 1048576 }'
    else
        awk -v k="$kib" 'BEGIN { printf "%dM", k / 1024 }'
    fi
}

# Deletes <dir> whole unless a build is using it: renamed into the trash
# (instant, same volume) and removed in the background, or before returning
# when <now>=1. <recreate>=1 puts an empty folder back, so a link to it stays
# valid. Returns 1, deleting nothing, when the folder is in use.
#
# A build in another process can start at any moment, so "in use" is decided
# while holding what a build holds. Cargo keeps an exclusive flock on
# <target>/<profile>/.cargo-lock (and <target>/<triple>/<profile>/.cargo-lock)
# for a whole build: those locks are taken without waiting, and a cargo
# already holding one makes the folder in use. While they are held, no cargo
# can start writing; a cargo that queues on one gets it after the rename and
# writes through the link into the new, empty folder. Folders without cargo
# locks (Xcode's DerivedData, Gradle, dotnet, lake) count as in use while any
# process holds a file or working directory inside them; that is checked last,
# immediately before the rename.
evict() {
    local dir="$1" recreate="$2" now="${3:-0}" slot
    mkdir -p "$TRASH"
    slot="$(python3 - "$dir" "$TRASH" "$recreate" <<'PY'
import fcntl, os, subprocess, sys, tempfile

folder, trash, recreate = os.path.realpath(sys.argv[1]), sys.argv[2], sys.argv[3] == "1"
held = []
for root, dirs, files in os.walk(folder):
    if root[len(folder):].count(os.sep) >= 2:
        dirs[:] = []
    if ".cargo-lock" in files:
        fd = os.open(os.path.join(root, ".cargo-lock"), os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(1)
        held.append(fd)
me = str(os.getpid())
pid = None
for line in subprocess.run(["lsof", "-n", "-Fpn"], capture_output=True, text=True).stdout.splitlines():
    if line.startswith("p"):
        pid = line[1:]
    elif line.startswith("n") and pid != me:
        name = line[1:]
        if name == folder or name.startswith(folder + "/"):
            sys.exit(1)
slot = tempfile.mkdtemp(prefix="evict.", dir=trash)
os.rename(folder, os.path.join(slot, os.path.basename(folder)))
if recreate:
    os.mkdir(folder)
print(slot)
PY
)" || return 1
    if [ "$now" = 1 ]; then
        rm -rf "$slot"
    else
        nohup rm -rf "$slot" >/dev/null 2>&1 &
    fi
}

empty_trash() {
    [ -d "$TRASH" ] || return 0
    nohup rm -rf "$TRASH" >/dev/null 2>&1 &
}

# Applies the caps of <top>'s manifest to the folders in <root>; with
# <idle> minutes > 0, also deletes folders nothing wrote to for that long.
prune_root() {
    local root="$1" top="$2" dry="$3" idle="${4:-0}" path cap kib reason
    while read -r path cap; do
        [ -d "$root/$path" ] || continue
        kib="$(kib_of "$root/$path")"
        if [ "${kib:-0}" -gt "$cap" ]; then
            reason="$(human "$kib") > $(human "$cap")"
        elif [ "$idle" -gt 0 ] && [ "${kib:-0}" -gt 1024 ] \
            && ! find "$root/$path" -xdev -mmin "-$idle" -print -quit 2>/dev/null | grep -q .; then
            reason="$(human "$kib"), no write in ${idle}m"
        else
            continue
        fi
        if [ "$dry" = 1 ]; then
            note "would delete $root/$path ($reason)"
        elif evict "$root/$path" 1; then
            note "deleted $root/$path ($reason); the next build refills it"
        else
            note "in use, kept: $root/$path ($reason)"
        fi
    done < <(manifest_entries "$top")
}

# Is <root>'s checkout still a worktree whose build root is <root>?
checkout_is_live() {
    local root="$1" top
    [ -f "$root/.checkout" ] || return 1
    top="$(cat "$root/.checkout")"
    [ -d "$top" ] || return 1
    git -C "$top" rev-parse --show-toplevel >/dev/null 2>&1 || return 1
    [ "$(git -C "$top" rev-parse --show-toplevel)" = "$top" ] || return 1
    [ "$(build_root "$top")" = "$root" ]
}

all_roots() {
    local marker
    for marker in "$ROOT"/*/*/.checkout; do
        [ -f "$marker" ] && dirname "$marker"
    done
    return 0
}

free_kib() { df -k "$ROOT" | awk 'NR==2 { print $4 }'; }

# The build folders the floor may delete, as "<newest write> <folder>", least
# recently written first: every live checkout's but main's and the app
# checkout's.
floor_candidates() {
    local root top path _cap
    while IFS= read -r root; do
        checkout_is_live "$root" || continue
        keeps_warm "$root" && continue
        top="$(cat "$root/.checkout")"
        while read -r path _cap; do
            [ -d "$root/$path" ] && echo "$(newest_write "$root/$path") $root/$path"
        done < <(manifest_entries "$top")
    done < <(all_roots) | sort -n
}

# Brings the volume's free space up to the floor by deleting whole folders
# nothing is building in, least recently written first, waiting for each
# deletion so the next free-space reading counts it. Main's and the app
# checkout's folders are never deleted here. Fails, naming the biggest
# folders, when every remaining folder is in use or freshly written.
keep_floor() {
    local free when dir kib root
    free="$(free_kib)"
    [ "$free" -ge "$FLOOR_KIB" ] && return 0
    note "the build volume has $(human "$free") free, under the $(human "$FLOOR_KIB") floor; deleting idle build folders outside main and the app checkouts, least recently written first"
    # Folders already renamed into the trash still hold their space until the
    # background removal finishes.
    if [ -d "$TRASH" ]; then
        rm -rf "$TRASH" 2>/dev/null || true
        free="$(free_kib)"
    fi
    while IFS= read -r root; do
        [ "$free" -ge "$FLOOR_KIB" ] && break
        checkout_is_live "$root" && continue
        kib="$(kib_of "$root")"
        if evict "$root" 0 1; then
            note "deleted $root ($(human "${kib:-0}"); its checkout is gone)"
            free="$(free_kib)"
        fi
    done < <(all_roots)
    while read -r when dir; do
        [ "$free" -ge "$FLOOR_KIB" ] && break
        kib="$(kib_of "$dir")"
        [ "${kib:-0}" -gt 1024 ] || continue
        if find "$dir" -xdev -mmin "-$FLOOR_IDLE_MINUTES" -print -quit 2>/dev/null | grep -q .; then
            continue
        fi
        if evict "$dir" 1 1; then
            note "deleted $dir ($(human "$kib"), last write $(date -r "${when:-0}" '+%Y-%m-%d %H:%M')); its next build refills it"
            free="$(free_kib)"
        else
            note "in use, kept: $dir"
        fi
    done < <(floor_candidates)
    [ "$free" -ge "$FLOOR_KIB" ] && return 0
    {
        echo "builds: the build volume has $(human "$free") free, under the $(human "$FLOOR_KIB") a build may need, and every build folder left is in use, was written in the last ${FLOOR_IDLE_MINUTES}m, or is main's or an app checkout's, which stay warm. The biggest the floor may delete:"
        floor_candidates | while read -r _when dir; do
            echo "$(kib_of "$dir") $dir"
        done | sort -rn | head -8 | while read -r kib dir; do
            echo "    $(human "$kib")  $dir"
        done
        echo "Kept warm:"
        all_roots | while IFS= read -r root; do
            if checkout_is_live "$root" && keeps_warm "$root"; then
                echo "    $(human "$(kib_of "$root")")  $root"
            fi
        done
        echo "Retire finished side worktrees (builds retire), or free space outside the build folders (the reclaim-disk skill)."
    } >&2
    exit 1
}

cmd_prune() {
    local dry=0 idle=0 root top
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1; shift ;;
            --idle)
                case "${2:-}" in ''|*[!0-9]*) die "prune: --idle takes minutes" ;; esac
                idle="$2"; shift 2 ;;
            *) die "prune: unknown option $1" ;;
        esac
    done
    require_volume
    while IFS= read -r root; do
        top="$(cat "$root/.checkout")"
        if ! checkout_is_live "$root"; then
            if [ "$dry" = 1 ]; then
                note "would delete $root (checkout $top is gone)"
            elif evict "$root" 0; then
                note "deleted $root (checkout $top is gone)"
            else
                note "checkout $top is gone but $root is in use, kept"
            fi
            continue
        fi
        prune_root "$root" "$top" "$dry" "$idle"
    done < <(all_roots)
    if [ "$dry" = 0 ]; then
        empty_trash
    fi
}

# ── Status ──────────────────────────────────────────────────────────────────

newest_write() {
    find "$1" -maxdepth 2 -print0 2>/dev/null \
        | xargs -0 stat -f '%m' 2>/dev/null | sort -n | tail -1
}

cmd_status() {
    local root top path cap kib when state total
    require_volume
    while IFS= read -r root; do
        top="$(cat "$root/.checkout")"
        if checkout_is_live "$root"; then
            state="$(git -C "$top" branch --show-current 2>/dev/null)"
            state="${state:-detached}"
            if [ "$(basename "$root")" != main ] && keeps_warm "$root"; then
                state="$state, app checkout"
            fi
            echo "${root#"$ROOT"/}  $top  [$state]"
        else
            echo "${root#"$ROOT"/}  $top  [checkout gone: prune deletes this root]"
            echo "    $(human "$(kib_of "$root")") total"
            continue
        fi
        total=0
        while read -r path cap; do
            if [ ! -d "$root/$path" ]; then
                printf '    %-34s %8s / %-6s  (no folder)\n' "$path" - "$(human "$cap")"
                continue
            fi
            kib="$(kib_of "$root/$path")"
            total=$(( total + kib ))
            when="$(newest_write "$root/$path")"
            if [ "$kib" -gt "$cap" ]; then state="OVER CAP"; else state=""; fi
            printf '    %-34s %8s / %-6s  last write %s  %s\n' "$path" "$(human "$kib")" \
                "$(human "$cap")" "$(date -r "${when:-0}" '+%Y-%m-%d %H:%M')" "$state"
            if [ -L "$top/$path" ]; then
                [ "$(absolute_link_target "$top/$path")" = "$root/$path" ] \
                    || echo "      link points elsewhere: $(readlink "$top/$path")"
            else
                echo "      not linked: run builds setup $top"
            fi
        done < <(manifest_entries "$top")
        echo "    $(human "$total") total"
    done < <(all_roots)
    # --show-stats would start a server if none is listening; only ask a
    # running one.
    if lsof -nP -iTCP:4226 -sTCP:LISTEN >/dev/null 2>&1; then
        sccache --show-stats 2>/dev/null \
            | grep -E '^(Cache location|Cache size|Max cache size)' | sed 's/^/sccache: /' || true
    fi
    df -h "$ROOT" | awk 'NR==2 { print "volume: " $4 " free of " $2 }'
}

# ── New / retire ────────────────────────────────────────────────────────────

cmd_new() {
    local repo_path="." branch="" main repo parent n dir hook
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--branch) branch="$2"; shift 2 ;;
            -*) die "new: unknown option $1" ;;
            *) repo_path="$1"; shift ;;
        esac
    done
    require_volume
    main="$(main_checkout "$(checkout_top "$repo_path")")"
    repo="$(basename "$main")"
    parent="$(dirname "$main")/$repo-worktrees"
    n=1
    while [ -e "$parent/side-$n" ] || [ -e "$ROOT/$repo/side-$n" ]; do
        n=$(( n + 1 ))
    done
    dir="$parent/side-$n"
    mkdir -p "$parent"
    git -C "$main" fetch -q origin
    # The hooks the common .git points at may belong to another checkout; this
    # one's own post-checkout runs below, after its build paths are linked.
    if [ -n "$branch" ]; then
        git -C "$main" -c core.hooksPath=/dev/null worktree add -q -b "$branch" "$dir" origin/main
    else
        git -C "$main" -c core.hooksPath=/dev/null worktree add -q --detach "$dir" origin/main
    fi
    cmd_setup "$dir"
    if [ -x "$dir/scripts/install-hooks.sh" ]; then
        (cd "$dir" && ./scripts/install-hooks.sh >/dev/null)
    fi
    hook="$dir/scripts/hooks/post-checkout"
    if [ -x "$hook" ]; then
        (cd "$dir" && "$hook" 0000000000000000000000000000000000000000 "$(git rev-parse HEAD)" 1)
    fi
    echo "$dir"
}

cmd_retire() {
    local top main root repo
    [ $# -eq 1 ] || die "usage: builds retire <checkout>"
    top="$(checkout_top "$1")"
    main="$(main_checkout "$top")"
    [ "$top" != "$main" ] || die "$top is the main checkout; only side worktrees retire"
    repo="$(repo_name "$top")"
    if [ "$(checkout_name "$top")" = "$(app_checkout_of "$repo")" ]; then
        die "$top is $repo's app checkout; record another with builds app-checkout, or delete $(app_checkout_file "$repo"), first"
    fi
    root="$(build_root "$top")"
    if [ -n "$(git -C "$top" status --porcelain)" ]; then
        die "$top has uncommitted or untracked files; commit or remove them first"
    fi
    git -C "$main" worktree remove "$top"
    if [ -d "$root" ]; then
        evict "$root" 0 \
            || die "worktree removed, but a process holds files in $root; run builds prune once it exits"
    fi
    note "retired $top and deleted $root"
}

# Records side worktree <checkout> as its repo's app checkout, replacing the
# one recorded before.
cmd_app_checkout() {
    local top repo name file
    [ $# -eq 1 ] || die "usage: builds app-checkout <checkout>"
    top="$(checkout_top "$1")"
    [ "$top" != "$(main_checkout "$top")" ] \
        || die "$top is the main checkout, which keeps its builds warm already; the app checkout is a side worktree"
    require_volume
    repo="$(repo_name "$top")"
    name="$(checkout_name "$top")"
    file="$(app_checkout_file "$repo")"
    mkdir -p "$ROOT/$repo"
    printf '%s\n' "$name" > "$file"
    note "recorded $top as $repo's app checkout in $file; the free-space floor keeps its folders"
}

# ── Install ─────────────────────────────────────────────────────────────────

SCCACHE_LABEL=local.sccache-server
SCCACHE_CACHE_SIZE_BYTES=$(( 40 * 1024 * 1024 * 1024 ))

cmd_install() {
    local sccache_bin config_dir plist
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$SELF" "$HOME/.local/bin/builds"
    note "linked ~/.local/bin/builds -> $SELF"

    sccache_bin="$(command -v sccache)" || die "sccache is not installed"
    # sccache reads this file on every client and server start, whatever the
    # caller's environment, so the cap holds for builds that never source a
    # shell profile.
    config_dir="$HOME/Library/Application Support/Mozilla.sccache"
    mkdir -p "$config_dir"
    cat > "$config_dir/config" <<EOF
# Written by builds install ($SELF).
[cache.disk]
size = $SCCACHE_CACHE_SIZE_BYTES
EOF
    note "wrote $config_dir/config (40 GiB cache)"

    # One server on sccache's default TCP port, started with the system
    # TMPDIR: a server inherits the TMPDIR of whichever client starts it, and a
    # session-scoped TMPDIR deleted later fails every compile. launchd starts
    # it at login, restarts it if it exits, and it never idles out, so no
    # client has a reason to start one of its own. SCCACHE_START_SERVER=1 makes
    # this process the server and SCCACHE_NO_DAEMON=1 keeps it from forking, so
    # it is the process launchd watches (`--start-server` forks the server off,
    # and the server daemonizes itself without NO_DAEMON).
    plist="$HOME/Library/LaunchAgents/$SCCACHE_LABEL.plist"
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by builds install ($SELF). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$SCCACHE_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>TMPDIR="\$(getconf DARWIN_USER_TEMP_DIR)" exec "$sccache_bin"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCCACHE_START_SERVER</key>
    <string>1</string>
    <key>SCCACHE_NO_DAEMON</key>
    <string>1</string>
    <key>SCCACHE_IDLE_TIMEOUT</key>
    <string>0</string>
    <key>SCCACHE_ERROR_LOG</key>
    <string>$HOME/Library/Logs/sccache-server.log</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)/$SCCACHE_LABEL" 2>/dev/null || true
    "$sccache_bin" --stop-server >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    note "started the sccache server under launchd ($plist)"
}

# ── Dispatch ────────────────────────────────────────────────────────────────

[ $# -ge 1 ] || { sed -n '2,/^$/s/^# \{0,1\}//p' "$SELF"; exit 2; }
command="$1"
shift
case "$command" in
    setup) cmd_setup "$@" ;;
    new) cmd_new "$@" ;;
    retire) cmd_retire "$@" ;;
    app-checkout) cmd_app_checkout "$@" ;;
    status) cmd_status "$@" ;;
    prune) cmd_prune "$@" ;;
    install) cmd_install "$@" ;;
    -h|--help|help) sed -n '2,/^$/s/^# \{0,1\}//p' "$SELF" ;;
    *) die "unknown command $command (setup | new | retire | app-checkout | status | prune | install)" ;;
esac
