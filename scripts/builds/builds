#!/bin/bash
# builds: owns this machine's build volume, /Volumes/Builds, and everything
# on it:
#
#   <repo>/<checkout>/    one build root per checkout; checkout = main | side-N
#   <repo>/app-checkout   the name of the repo's app checkout (side-N)
#   <repo>/app.lock       the lock agents hold to build in the app checkout
#   DerivedData/          Xcode's default DerivedData location
#   caches/<name>/        download caches every checkout shares, each linked
#                         from where its tool looks (~/.gradle -> caches/gradle)
#   .trash/               folders being deleted in the background
#
# `builds status` lists each of these and flags anything else on the volume as
# UNKNOWN; it leaves out macOS's own volume metadata (.Spotlight-V100,
# .fseventsd, .Trashes, ...).
#
# Build roots. The repo lists its build-output paths and their size caps in
# `.build-dirs` at its root. Each listed path is a symlink in the checkout to
# the same path under the checkout's build root
# (target -> /Volumes/Builds/bae/main/target).
#
# The path a tool sees never changes: cargo, xcodebuild, Gradle, dotnet and
# lake always write through `<checkout>/<path>`, so sccache keys and cargo
# fingerprints stay valid however often the folder behind the link is deleted
# and recreated. Two checkouts never share a folder, so their builds never
# wait on each other's locks.
#
# DerivedData. bae's build scripts pass -derivedDataPath into a `.build` folder
# in the checkout, so no checkout's build lives here: only what one-off
# xcodebuild runs (-showBuildSettings, package resolves) and the Xcode app
# write, one <project>-<hash> entry per project path, mostly SwiftPM checkouts
# of about 3 GB. It is one disposable cache with a cap: entries are deleted,
# least recently written first, while the folder is over its cap, when nothing
# wrote to them for a day (`prune`), and first of anything under the floor.
#
# Shared caches. Gradle, npm, NuGet, SwiftPM and sccache keep their downloads
# and compiler outputs here for every checkout. Each has a cap; a cache over
# its cap is deleted whole by `setup` and `prune` once nothing has written to
# it for 30 minutes, and nothing else deletes one: deleting it makes every
# checkout, warm ones included, download it all again, and a SwiftPM fetch cut
# off halfway corrupts its cache. sccache keeps its own cache under the cap
# `install` writes into its config; this tool only shows it.
#
# Build output in the temporary folders. A build pointed at /private/tmp or
# the user's temporary folder (CARGO_TARGET_DIR, -derivedDataPath, a probe
# crate built where it was made) writes 5-14 GB there that nothing else
# deletes. `setup` and `prune` delete each cargo target, DerivedData or
# SwiftPM folder there (temp_builds.py) that nothing wrote to for 30 minutes
# and no process holds a file in; status lists them. They skip
# /private/tmp's claude-* (Claude Code sessions' scratch, whose entries go
# after three days), com.apple.* and tmux-* (live sockets). Nothing on this
# machine points a build there: build into the checkout, whose paths lead to
# the volume.
#
# Commands:
#   builds setup [<checkout>]   link the checkout's build paths, recreate any
#                               missing folder, delete its unused build copies
#                               (below), apply the caps to it, to DerivedData
#                               and to the shared caches, delete idle build
#                               output in the temporary folders, then make
#                               sure the volume has the free-space floor.
#                               The repo's hooks and build scripts run this.
#   builds new [<repo>] [-b <branch>]
#                               add the next free side-N worktree from
#                               origin/main, link it, run its post-checkout
#                               [--for <who>]: claim it for <who> (below)
#   builds claim <checkout> <who>
#                               record that <who> works in the side worktree
#   builds release <checkout>   remove its claim
#   builds retire <checkout>    remove a side worktree and its build root
#   builds app-checkout <checkout>
#                               record the side worktree as its repo's app
#                               checkout, in /Volumes/Builds/<repo>/app-checkout
#   builds status               every entry on the volume: size per folder vs
#                               cap, last write, links; and build output in
#                               the temporary folders
#   builds prune [--dry-run] [--idle <minutes> [--include-warm]]
#                               delete every checkout's unused build copies
#                               (below) and apply every cap; delete roots whose
#                               checkout is gone, DerivedData entries nothing
#                               wrote to for a day, build output in the
#                               temporary folders nothing wrote to for 30
#                               minutes, and cargo's git checkouts no
#                               checkout's Cargo.lock pins. --idle also
#                               deletes every folder and DerivedData entry
#                               nothing wrote to for that long, outside
#                               main and the app checkout unless --include-warm
#   builds cargo <subcommand> [<args>...]
#                               run cargo (build, check, clippy, doc, rustc,
#                               rustdoc, test, bench, run, install, nextest
#                               run|list|archive) and record the build copies
#                               it used; the rest of its output, a program's or
#                               the tests', passes through
#   builds record-use           record the build copies a cargo report on stdin
#                               (--message-format=json-render-diagnostics)
#                               names, passing every other line through
#   builds install              put `builds` on PATH, create the shared caches
#                               and their links, write the sccache config, run
#                               the sccache server under launchd, point Xcode's
#                               default DerivedData at the volume
#
# Claims. A claim records who works in a side worktree, so another session
# doesn't take it: whoever hands out the worktree (a coordinator dispatching an
# agent, a person) claims it and releases it when the work lands or moves on.
# It is a file in the worktree's own git dir, so it goes when the worktree
# does; `status` shows it, and `retire` refuses a claimed worktree. A claim is
# not a lock: agents are a series of separate commands, so nothing could hold
# one, and a session that ends without releasing leaves its claim behind
# (status shows its age). Short exclusive use, one build at a time, stays a
# real lock, like the app checkout's app.lock.
#
# By default a side worktree builds host Rust only, and a repo with app builds
# keeps them warm in main and in one side worktree, its app checkout, which
# agents take turns in by holding /Volumes/Builds/<repo>/app.lock; see
# principles/worktree-build-priming.md. Nothing here enforces who builds what:
# the caps bound whatever a checkout builds, and the floor below bounds every
# checkout but main and the app checkout.
#
# Unused build copies. Cargo names each unit it builds (one crate target, for
# one profile, target and feature set) by a hash of everything that build
# depends on, dependency versions included: every dependency bump builds a new
# copy of each unit above it, and the old copies stay. `cargo` and
# `record-use` record each unit a build reports, whether it rebuilt it or found
# it up to date, by setting its fingerprint folder's modification time; a unit
# no recorded build has used counts as used when cargo last built it. `setup`
# and `prune` delete, in each cargo folder (target, target-macos, ...), every
# file of each unit nothing used for BUILDS_UNUSED_DAYS days (default 3), and
# of each unit a newer copy of the same thing replaced that nothing used for
# BUILDS_SUPERSEDED_HOURS hours (default 12), and the incremental folders only
# those units used, while holding cargo's locks on that folder and keeping any
# unit a process holds a file of. The repo's hooks and build scripts run cargo
# through `builds cargo`.
#
# Under the same locks they delete, in units still in use and in every
# checkout, the object files no build or debugger reads. rustc leaves each
# unit's object files beside its outputs (split-debuginfo "unpacked", macOS's
# default) and a binary's debug map names the ones it was linked from: an
# rlib's members, never its loose objects, and only the newest of the sets
# each incremental rebuild or each build of a library with no hash in its name
# leaves under new names. One busy coven checkout piled up 22 GB of them in
# three hours.
#
# A folder still over its cap is deleted whole and recreated empty; the next
# build repopulates it, mostly from sccache. A folder that any process holds a
# file open in is never deleted.
#
# Sizes, against caps and in status, count each block once (disk_usage.py):
# du counts the blocks of an APFS clone once per file, and cargo uplifts its
# libraries out of deps/ as clones.
#
# Caps bound each folder, not the volume: a checkout with every platform built
# is 45-52 GB, and the build volume shares its APFS pool with the main disk.
# So `setup` also keeps a free-space floor: under it, it deletes DerivedData's
# idle entries, then whole idle folders across every checkout but main and the
# app checkout, whose builds stay warm on purpose, least recently written
# first. If it still can't reach the floor it warns, naming the biggest
# folders, and the build goes on: whoever runs the agents frees space or runs
# fewer of them. Only under the hard floor does it fail, rather than let the
# build run out of space halfway. It never deletes a shared cache.

set -euo pipefail

# A git hook runs this with its own repository's GIT_DIR, GIT_INDEX_FILE and
# the rest exported. Every git call here names the checkout it asks about with
# -C, so drop them: kept, git answers for the hook's repository about every
# other checkout, and each of another repo's build roots reads as orphaned.
# `cargo` and `record-use` call no git, and cargo runs in the caller's
# environment as it is.
# shellcheck disable=SC2046
case "${1:-}" in
    cargo|record-use) ;;
    *) unset $(git rev-parse --local-env-vars) ;;
esac

ROOT="${BUILDS_ROOT:-/Volumes/Builds}"
TRASH="$ROOT/.trash"
MANIFEST=.build-dirs
# The free space a build may need. bae's iOS build is the largest single
# platform build (target-ios 12.2G + bae-ios/.build 4.9G fresh); another
# checkout building macOS at the same time (bridge 7.4G + DerivedData 5.2G) is
# the headroom.
FLOOR_KIB=$(( ${BUILDS_FREE_FLOOR_GIB:-30} * 1024 * 1024 ))
# Under this a build fails instead of warning: the space left is about one
# platform build, and the main disk shares the pool, so running out would
# break the person's own apps too, not only the build.
HARD_FLOOR_KIB=$(( ${BUILDS_HARD_FLOOR_GIB:-10} * 1024 * 1024 ))
# A folder written this recently may belong to a build between two of its
# steps, when it holds no lock or open file; the floor never deletes it.
FLOOR_IDLE_MINUTES=30
# A build copy no build used for this many days is deleted. A coven pin bump
# in bae makes a new copy of everything above coven; three days keeps the
# copies a branch from the last few days still builds against. Before it,
# main's target held 93 copies of bae-core, 13 GB, going back a week.
UNUSED_DAYS="${BUILDS_UNUSED_DAYS:-3}"
case "$UNUSED_DAYS" in
    ''|*[!0-9]*|0) echo "builds: BUILDS_UNUSED_DAYS must be a whole number of days, at least 1, got '$UNUSED_DAYS'" >&2; exit 1 ;;
esac
# A build copy a newer copy of the same thing replaced (a coven pin bump in
# bae replaces every copy above coven) is deleted once no build used it for
# this many hours. Half a day keeps what a branch checked out earlier the
# same day builds against; main never goes back to an older pin.
SUPERSEDED_HOURS="${BUILDS_SUPERSEDED_HOURS:-12}"
case "$SUPERSEDED_HOURS" in
    ''|*[!0-9]*|0) echo "builds: BUILDS_SUPERSEDED_HOURS must be a whole number of hours, at least 1, got '$SUPERSEDED_HOURS'" >&2; exit 1 ;;
esac

# Xcode's default DerivedData location (`install` sets it). 15G holds five
# one-off entries of about 3 GB, more than the checkouts that run one-offs at
# once (main, the app checkout, a side worktree or two); before it had a cap,
# nine entries had piled up to 27 GB, four from worktrees already removed.
DERIVED_DATA="$ROOT/DerivedData"
DERIVED_DATA_CAP=15G
# `prune` deletes an entry nothing wrote to for this long: a day of work keeps
# what that day's one-off runs resolved.
DERIVED_DATA_IDLE_MINUTES=1440

CACHES="$ROOT/caches"
# The shared caches, each a folder in $CACHES with a link to it from where its
# tool looks, relative to $HOME. Caps are about twice each cache's size when
# they got them (Oct 2026: gradle 3.4G, npm 0.3G, nuget 2.6G, swiftpm 1.0G).
# Old Gradle, AGP and NuGet package versions pile up as dependencies move, and
# deleting a cache costs every checkout a download, so the cap leaves room
# rather than fitting tightly. sccache's cap is the size `install` writes into
# its config, and sccache evicts within it itself; its own accounting reads
# about 0.2 GiB under the folder's size on disk, so status may show it a
# little over. 30G holds about two
# days of builds: on a day of agents building in seven bae and five coven
# checkouts sccache wrote 12.6G, and nothing in it was older than three days.
#
# The links for Gradle and NuGet point at their tools' whole home folders,
# which also hold settings the person writes (gradle.properties, init
# scripts, NuGet.Config). The last column lists them, comma-separated; a
# deletion copies them out first and puts them back in the emptied folder.
shared_caches() {
    cat <<'EOF'
# name    cap   link from $HOME                    settings kept
gradle    8G    .gradle                            gradle.properties,init.d,init.gradle,init.gradle.kts
npm       1G    .npm                               -
nuget     6G    .nuget                             NuGet/NuGet.Config
swiftpm   3G    Library/Caches/org.swift.swiftpm   -
sccache   30G   Library/Caches/Mozilla.sccache     -
EOF
}

# macOS's own entries at the root of a volume; status leaves them out.
SYSTEM_ENTRIES=" .DS_Store .Spotlight-V100 .fseventsd .TemporaryItems .Trashes .DocumentRevisions-V100 .VolumeIcon.icns .com.apple.timemachine.donotpresent "

# This script's own path, through the ~/.local/bin link `install` makes.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    link_target="$(readlink "$self")"
    case "$link_target" in
        /*) self="$link_target" ;;
        *) self="$(dirname "$self")/$link_target" ;;
    esac
done
SELF="$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")"
# Cargo's build copies in a build folder: recording their use, and pruning.
UNITS="$(dirname "$SELF")/cargo_units.py"
# The space a folder takes, counting blocks APFS clones share once.
USAGE="$(dirname "$SELF")/disk_usage.py"
# Build output in the temporary folders.
TEMP_BUILDS="$(dirname "$SELF")/temp_builds.py"

# A failure that says why: what `die` reports, the exit trap below stays
# quiet about.
REPORTED=0
die() { echo "builds: $*" >&2; REPORTED=1; exit 1; }
# Under `set -e` and pipefail, a command that fails without printing (a find
# whose errors go to /dev/null, a grep that matched nothing) ends the tool,
# and the hook or build script that ran it, with no word of why. Name it.
trap 'status=$?; if [ "$status" -ne 0 ] && [ "$REPORTED" -eq 0 ]; then echo "builds: stopped where \`$BASH_COMMAND\` exited $status" >&2; fi' EXIT
note() { echo "builds: $*" >&2; }

# ── Checkout identity ───────────────────────────────────────────────────────

checkout_top() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null \
        || die "$1 is not inside a git checkout"
}

# The main checkout: the directory holding the common .git.
main_checkout() {
    local common
    common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)"
    dirname "$common"
}

repo_name() { basename "$(main_checkout "$1")"; }

checkout_name() {
    local top="$1"
    if [ "$top" = "$(main_checkout "$top")" ]; then
        echo main
    else
        basename "$top"
    fi
}

build_root() { echo "$ROOT/$(repo_name "$1")/$(checkout_name "$1")"; }

# The file naming <repo>'s app checkout, the one side worktree that keeps app
# builds warm beside main; `builds app-checkout` writes it. It sits beside the
# app checkout's lock, /Volumes/Builds/<repo>/app.lock.
app_checkout_file() { echo "$ROOT/$1/app-checkout"; }

# Prints <repo>'s app checkout name (side-N), or nothing when none is recorded.
app_checkout_of() {
    local file
    file="$(app_checkout_file "$1")"
    [ -f "$file" ] && cat "$file"
    return 0
}

# Is <root> (/Volumes/Builds/<repo>/<checkout>) main's or the app checkout's?
# Their builds stay warm on purpose: the person installs from main and tests
# agents' app builds in the app checkout. The free-space floor never deletes
# their folders; the caps still apply to them.
keeps_warm() {
    local checkout repo
    checkout="$(basename "$1")"
    repo="$(basename "$(dirname "$1")")"
    [ "$checkout" = main ] || [ "$checkout" = "$(app_checkout_of "$repo")" ]
}

# ── Manifest ────────────────────────────────────────────────────────────────

# Prints <cap> (20G, 500M) in KiB; fails naming <what> when it is neither.
cap_kib() {
    local cap="$1" what="$2"
    case "$cap" in
        *[!0-9GM]*|[GM]*) ;;
        *[0-9]G) echo $(( ${cap%G} * 1024 * 1024 )); return 0 ;;
        *[0-9]M) echo $(( ${cap%M} * 1024 )); return 0 ;;
    esac
    die "$what needs a cap like 20G or 500M, got '$cap'"
}

# Prints "<path> <cap-in-KiB>" per listed path; fails on a malformed line.
manifest_entries() {
    local file="$1/$MANIFEST" path cap rest kib
    [ -f "$file" ] || return 0
    while read -r path cap rest; do
        case "$path" in ''|'#'*) continue ;; esac
        [ -z "$rest" ] || die "$file: extra field after '$path $cap'"
        case "$path" in
            /*|..|../*|*/..|*/../*) die "$file: '$path' must be inside the checkout" ;;
        esac
        kib="$(cap_kib "$cap" "$file: '$path'")" || { REPORTED=1; exit 1; }
        echo "$path $kib"
    done < "$file"
}

# Prints "<name> <cap-in-KiB> <link> <settings>" per shared cache, <link>
# absolute.
shared_cache_entries() {
    local name cap link settings rest kib
    while read -r name cap link settings rest; do
        case "$name" in ''|'#'*) continue ;; esac
        [ -n "$settings" ] && [ -z "$rest" ] \
            || die "shared cache $name needs a cap, a link and its settings ('-' for none)"
        kib="$(cap_kib "$cap" "shared cache $name")" || { REPORTED=1; exit 1; }
        echo "$name $kib $HOME/$link $settings"
    done < <(shared_caches)
}

has_manifest() { [ -f "$1/$MANIFEST" ]; }

require_volume() {
    [ -d "$ROOT" ] || die "build volume $ROOT is not mounted"
}

# A repo's folder sits beside DerivedData, caches and .trash at the volume's
# root, so a repo can't take one of their names.
require_repo_name() {
    local repo
    repo="$(repo_name "$1")"
    case "$repo" in
        "$(basename "$DERIVED_DATA")"|"$(basename "$CACHES")"|.*)
            die "repo $repo would build into $ROOT/$repo, which builds keeps for something else" ;;
    esac
}

# ── Ownership of old folders during migration ──────────────────────────────

worktrees_of() {
    git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p'
}

absolute_link_target() {
    local link="$1" target
    target="$(readlink "$link")"
    case "$target" in
        /*) echo "$target" ;;
        *) echo "$(cd "$(dirname "$link")" && pwd -P)/$target" ;;
    esac
}

# May checkout <top> delete <folder>, the folder its link points at today?
# Never a folder inside another live checkout's build root. A folder from an
# older layout that another checkout's link also points at is the main
# checkout's to delete; a side checkout leaves it and starts its own.
may_delete() {
    local folder="$1" top="$2" repo wt path _kib owner
    repo="$(repo_name "$top")"
    case "$folder" in
        "$ROOT/$repo"/*/*)
            owner="${folder#"$ROOT/$repo"/}"
            owner="${owner%%/*}"
            if [ -f "$ROOT/$repo/$owner/.checkout" ]; then
                wt="$(cat "$ROOT/$repo/$owner/.checkout")"
                if [ "$wt" != "$top" ] && checkout_is_live "$ROOT/$repo/$owner"; then
                    return 1
                fi
            fi
            ;;
    esac
    [ "$(checkout_name "$top")" = main ] && return 0
    while IFS= read -r wt; do
        [ "$wt" = "$top" ] && continue
        while read -r path _kib; do
            if [ -L "$wt/$path" ] && [ "$(absolute_link_target "$wt/$path")" = "$folder" ]; then
                return 1
            fi
        done < <(manifest_entries "$top")
    done < <(worktrees_of "$top")
    return 0
}

# ── Linking ─────────────────────────────────────────────────────────────────

# Makes <link> a symlink to <dest> and makes sure <dest> exists. A folder at
# any other place — behind a link to an older location (when may_delete says
# it is this checkout's), or a real directory a tool left before the link
# existed — is deleted, never moved: Xcode's DerivedData records its own
# absolute path, so a moved one fails to find its packages. The next build
# refills <dest>, cargo mostly from sccache.
place() {
    local link="$1" dest="$2" top="$3" current
    if [ -L "$link" ]; then
        current="$(absolute_link_target "$link")"
        if [ "$current" != "$dest" ]; then
            if [ -d "$current" ] && may_delete "$current" "$top"; then
                evict "$current" 0 \
                    || die "a build is using $current; run builds setup again once it ends"
                note "deleted $current, a folder from an older layout"
            fi
            ln -sfn "$dest" "$link"
            note "linked ${link#"$top"/} -> $dest"
        fi
    elif [ -e "$link" ]; then
        evict "$link" 0 \
            || die "a build is using ${link#"$top"/}; run builds setup again once it ends"
        note "deleted ${link#"$top"/}, a real directory; it builds into $dest now"
        ln -s "$dest" "$link"
        note "linked ${link#"$top"/} -> $dest"
    else
        mkdir -p "$(dirname "$link")"
        ln -s "$dest" "$link"
        note "linked ${link#"$top"/} -> $dest"
    fi
    # A link whose folder was deleted breaks every tool that writes through it
    # (cargo os error 20, xcodebuild rc 74, Gradle's file hash cache, dotnet
    # MSB3021, lake error 17); recreating the folder is all any of them need.
    mkdir -p "$dest"
}

cmd_setup() {
    local top root path kib
    top="$(checkout_top "${1:-.}")"
    has_manifest "$top" || { note "$top has no $MANIFEST; nothing to link"; return 0; }
    require_volume
    require_repo_name "$top"
    root="$(build_root "$top")"
    mkdir -p "$root"
    printf '%s\n' "$top" > "$root/.checkout"
    while read -r path kib; do
        place "$top/$path" "$root/$path" "$top"
        if [ "$path" = target ] && [ -n "${CARGO_TARGET_DIR:-}" ]; then
            note "CARGO_TARGET_DIR=$CARGO_TARGET_DIR overrides $top/target for cargo run here"
        fi
    done < <(manifest_entries "$top")
    prune_root "$root" "$top" 0
    prune_derived_data 0 0
    prune_caches 0
    prune_test_temps 0
    prune_temp_builds 0
    prune_scratchpads 0
    prune_cargo_git 0
    keep_floor
}

# Cargo's git checkouts (~/.cargo/git/checkouts/<repo>-<hash>/<commit>), one
# per commit any build fetched: each one no Cargo.lock of a live checkout this
# tool knows pins goes. The git databases (~/.cargo/git/db) stay, and cargo
# checks a commit out of them again in seconds when a branch needs it.
prune_cargo_git() {
    local dry="$1" root top path lockfiles=()
    while IFS= read -r root; do
        checkout_is_live "$root" || continue
        top="$(cat "$root/.checkout")"
        while IFS= read -r path; do
            lockfiles+=("$top/$path")
        done < <(git -C "$top" ls-files -- Cargo.lock '*/Cargo.lock')
    done < <(all_roots)
    # With no lockfile to read, every checkout would read as unpinned.
    [ "${#lockfiles[@]}" -gt 0 ] || return 0
    python3 "$UNITS" git-checkouts "${CARGO_HOME:-$HOME/.cargo}" "$dry" "${lockfiles[@]}" >/dev/null \
        || die "pruning cargo's git checkouts failed"
}

# Delete each entry `find <args>` lists, called `what`, or with `dry` only
# say how many it would. These prunes free space and change nothing a build
# reads, so a failure, such as another session's scratch folder vanishing
# while it is listed, is noted and the build goes on.
prune_listed() {
    local dry="$1" what="$2" errors listing count
    shift 2
    errors="$(mktemp)"
    if ! listing="$(find "$@" 2>"$errors")"; then
        note "listing $what failed, so none were deleted: $(tr '\n' ' ' < "$errors")"
        rm -f "$errors"
        return 0
    fi
    count="$(printf '%s' "$listing" | grep -c . || true)"
    if [ "$count" -eq 0 ]; then
        :
    elif [ "$dry" = 1 ]; then
        note "would delete $count $what"
    elif find "$@" -prune -exec rm -rf {} + 2>"$errors"; then
        note "deleted $count $what"
    else
        note "deleting $count $what failed partway: $(tr '\n' ' ' < "$errors")"
    fi
    rm -f "$errors"
}

# Claude Code sessions' scratch folders (/private/tmp/claude-<uid>/<project>/
# <session>/scratchpad): an entry nothing has written for three days is a
# finished probe, build or log. Anything worth keeping belongs in the repo or
# its plans/.
prune_scratchpads() {
    local dry="$1" base="/private/tmp/claude-$(id -u)" folder folders=()
    for folder in "$base"/*/*/scratchpad; do
        [ -d "$folder" ] && folders+=("$folder")
    done
    [ "${#folders[@]}" -gt 0 ] || return 0
    prune_listed "$dry" "scratch entries older than three days under $base" \
        "${folders[@]}" -maxdepth 1 -mindepth 1 -mtime +3 -user "$(id -un)"
}

# The temporary folders build output can land in: /private/tmp, the user's
# temporary folder (`getconf DARWIN_USER_TEMP_DIR`, where mktemp puts things),
# and this session's $TMPDIR when it is another, unless it is inside a Claude
# Code session's folder (/private/tmp/claude-*), which is skipped whole.
temp_folders() {
    local user tmp="${TMPDIR:-}"
    user="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
    echo /private/tmp
    [ -n "$user" ] && echo "${user%/}"
    case "$tmp" in
        ''|/tmp|/tmp/|/private/tmp|/private/tmp/|/tmp/claude-*|/private/tmp/claude-*) ;;
        *) [ "${tmp%/}" = "${user%/}" ] || echo "${tmp%/}" ;;
    esac
    return 0
}

# Build output in the temporary folders (temp_builds.py): a cargo target
# folder, an Xcode DerivedData folder or a SwiftPM folder a build was pointed
# at there, or a probe built where it was made. Each one nothing wrote to in
# the last FLOOR_IDLE_MINUTES (a build between two of its steps holds no file
# open) and no process holds a file in is deleted.
temp_build_folders() {
    local folders=() folder
    while IFS= read -r folder; do
        [ -d "$folder" ] && folders+=("$folder")
    done < <(temp_folders)
    [ "${#folders[@]}" -gt 0 ] || return 0
    python3 "$TEMP_BUILDS" "${folders[@]}" || die "listing build output in ${folders[*]} failed"
}

prune_temp_builds() {
    local dry="$1" folder kib
    while IFS= read -r folder; do
        has_write_within "$folder" "$FLOOR_IDLE_MINUTES" && continue
        kib="$(kib_of "$folder")"
        if [ "$dry" = 1 ]; then
            note "would delete $folder ($(human "${kib:-0}") of build output in a temporary folder, no write in ${FLOOR_IDLE_MINUTES}m)"
        elif evict "$folder" 0; then
            note "deleted $folder ($(human "${kib:-0}") of build output in a temporary folder, no write in ${FLOOR_IDLE_MINUTES}m)"
        else
            note "in use, kept: $folder (build output in a temporary folder)"
        fi
    done < <(temp_build_folders)
}

# Tests' temporary folders (tempfile's `.tmp*` under $TMPDIR) that a test left
# behind: nothing reads one a day after it was last written. Newer ones may
# belong to a test still running.
prune_test_temps() {
    local dry="$1"
    [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] || return 0
    prune_listed "$dry" "test temp folders older than a day in $TMPDIR" \
        "$TMPDIR" -maxdepth 1 -name '.tmp*' -type d -mtime +1 -user "$(id -un)"
}

# ── Pruning ─────────────────────────────────────────────────────────────────

kib_of() { python3 "$USAGE" "$1"; }

human() {
    local kib="$1"
    if [ "$kib" -ge 1048576 ]; then
        awk -v k="$kib" 'BEGIN { printf "%.1fG", k / 1048576 }'
    else
        awk -v k="$kib" 'BEGIN { printf "%dM", k / 1024 }'
    fi
}

# Deletes <dir> whole unless a build is using it: renamed into the trash
# (instant), and removed in the background, or before returning when <now>=1.
# The trash is $TRASH on the build volume, and for a folder on another volume
# a new folder beside it, since a rename can't cross volumes. <recreate>=1
# puts an empty folder back, so a link to it stays valid. Returns 1, deleting
# nothing, when the folder is in use.
#
# A build in another process can start at any moment, so "in use" is decided
# while holding what a build holds. Cargo keeps an exclusive flock on
# <target>/<profile>/.cargo-lock (and <target>/<triple>/<profile>/.cargo-lock)
# for a whole build: those locks are taken without waiting, and a cargo
# already holding one makes the folder in use. While they are held, no cargo
# can start writing; a cargo that queues on one gets it after the rename and
# writes through the link into the new, empty folder. Folders without cargo
# locks (Xcode's DerivedData, Gradle, dotnet, lake) count as in use while any
# process holds a file or working directory inside them; that is checked last,
# immediately before the rename.
evict() {
    local dir="$1" recreate="$2" now="${3:-0}" slot
    mkdir -p "$TRASH"
    slot="$(python3 - "$dir" "$TRASH" "$recreate" <<'PY'
import fcntl, os, subprocess, sys, tempfile

folder, trash, recreate = os.path.realpath(sys.argv[1]), sys.argv[2], sys.argv[3] == "1"
parent = os.path.dirname(folder)
if os.stat(parent).st_dev != os.stat(trash).st_dev:
    trash, prefix = parent, ".builds-deleting."
else:
    prefix = "evict."
held = []
for root, dirs, files in os.walk(folder):
    if root[len(folder):].count(os.sep) >= 2:
        dirs[:] = []
    if ".cargo-lock" in files:
        fd = os.open(os.path.join(root, ".cargo-lock"), os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(1)
        held.append(fd)
me = str(os.getpid())
pid = None
for line in subprocess.run(["lsof", "-n", "-Fpn"], capture_output=True, text=True).stdout.splitlines():
    if line.startswith("p"):
        pid = line[1:]
    elif line.startswith("n") and pid != me:
        name = line[1:]
        if name == folder or name.startswith(folder + "/"):
            sys.exit(1)
slot = tempfile.mkdtemp(prefix=prefix, dir=trash)
os.rename(folder, os.path.join(slot, os.path.basename(folder)))
if recreate:
    os.mkdir(folder)
print(slot)
PY
)" || return 1
    if [ "$now" = 1 ]; then
        rm -rf "$slot"
    else
        nohup rm -rf "$slot" >/dev/null 2>&1 &
    fi
}

empty_trash() {
    [ -d "$TRASH" ] || return 0
    nohup rm -rf "$TRASH" >/dev/null 2>&1 &
}

# Deletes the unused build copies in the folders of <root> (cargo_units.py
# prune); prints "<KiB freed>\t<folder>" per folder, which a dry run only
# counts.
prune_units() {
    local dry="$1"
    shift
    python3 "$UNITS" prune "$UNUSED_DAYS" "$SUPERSEDED_HOURS" "$dry" "$@" \
        || die "pruning unused build copies in $* failed"
}

# Deletes the unused build copies in the folders of <top>'s manifest in
# <root>, then applies the manifest's caps to them; with <idle> minutes > 0,
# also deletes folders nothing wrote to for that long.
prune_root() {
    local root="$1" top="$2" dry="$3" idle="${4:-0}" path cap kib reason freed folders=()
    while read -r path cap; do
        [ -d "$root/$path" ] && folders+=("$root/$path")
    done < <(manifest_entries "$top")
    [ "${#folders[@]}" -gt 0 ] || return 0
    freed="$(prune_units "$dry" "${folders[@]}")"
    while read -r path cap; do
        [ -d "$root/$path" ] || continue
        kib="$(kib_of "$root/$path")"
        if [ "$dry" = 1 ]; then
            # Nothing was deleted; measure the folder as pruning would leave it.
            kib=$(( ${kib:-0} - $(printf '%s\n' "$freed" \
                | awk -F '\t' -v folder="$root/$path" '$2 == folder { print $1; found = 1 } END { if (!found) print 0 }') ))
        fi
        if [ "${kib:-0}" -gt "$cap" ]; then
            reason="$(human "$kib") > $(human "$cap")"
        elif [ "$idle" -gt 0 ] && [ "${kib:-0}" -gt 1024 ] \
            && ! has_write_within "$root/$path" "$idle"; then
            reason="$(human "$kib"), no write in ${idle}m"
        else
            continue
        fi
        if [ "$dry" = 1 ]; then
            note "would delete $root/$path ($reason)"
        elif evict "$root/$path" 1; then
            note "deleted $root/$path ($reason); the next build refills it"
        else
            note "in use, kept: $root/$path ($reason)"
        fi
    done < <(manifest_entries "$top")
}

# Did anything write inside <dir> in the last <minutes>?
has_write_within() {
    find "$1" -xdev -mmin "-$2" -print -quit 2>/dev/null | grep -q .
}

# DerivedData's entries as "<newest write> <entry>", least recently written
# first.
derived_data_entries() {
    local entry
    [ -d "$DERIVED_DATA" ] || return 0
    for entry in "$DERIVED_DATA"/* "$DERIVED_DATA"/.[!.]*; do
        [ -e "$entry" ] || continue
        echo "$(newest_write "$entry") $entry"
    done | sort -n
}

# Deletes DerivedData entries, least recently written first: with <idle>
# minutes > 0, each one nothing wrote to for that long, and while the folder
# is over its cap, each one nothing wrote to in the last FLOOR_IDLE_MINUTES (a
# one-off run between two steps holds no file open). An entry in use is kept.
prune_derived_data() {
    local dry="$1" idle="$2" cap total _when entry kib reason
    [ -d "$DERIVED_DATA" ] || return 0
    cap="$(cap_kib "$DERIVED_DATA_CAP" DerivedData)"
    total="$(kib_of "$DERIVED_DATA")"
    [ "$idle" -gt 0 ] || [ "${total:-0}" -gt "$cap" ] || return 0
    while read -r _when entry; do
        kib="$(kib_of "$entry")"
        if [ "$idle" -gt 0 ] && ! has_write_within "$entry" "$idle"; then
            reason="$(human "${kib:-0}"), no write in ${idle}m"
        elif [ "$total" -gt "$cap" ] && ! has_write_within "$entry" "$FLOOR_IDLE_MINUTES"; then
            reason="$(human "${kib:-0}"); DerivedData is $(human "$total") > $(human "$cap")"
        else
            continue
        fi
        if [ "$dry" = 1 ]; then
            note "would delete $entry ($reason)"
        elif evict "$entry" 0; then
            note "deleted $entry ($reason)"
        else
            note "in use, kept: $entry ($reason)"
            continue
        fi
        total=$(( total - ${kib:-0} ))
    done < <(derived_data_entries)
}

# Copies the settings files <settings> (comma-separated paths, "-" for none)
# that <dir> holds into a new folder beside it, and prints that folder;
# prints nothing when <dir> holds none of them.
stage_settings() {
    local dir="$1" settings="$2" keep="" path
    [ "$settings" = - ] && return 0
    for path in ${settings//,/ }; do
        [ -e "$dir/$path" ] || continue
        [ -n "$keep" ] || keep="$(mktemp -d "$CACHES/.settings-$(basename "$dir").XXXXXX")"
        mkdir -p "$keep/$(dirname "$path")"
        cp -Rp "$dir/$path" "$keep/$path"
    done
    echo "$keep"
}

# Deletes each shared cache that is over its cap, whole, and recreates it
# empty, with its settings files put back, so its link stays valid; only once
# nothing has written to it in the last FLOOR_IDLE_MINUTES (a package resolve
# between two fetches holds no file open) and no process holds a file in it.
# sccache bounds its own cache.
prune_caches() {
    local dry="$1" name cap _link settings dir kib reason keep
    [ -d "$CACHES" ] || return 0
    while read -r name cap _link settings; do
        [ "$name" = sccache ] && continue
        dir="$CACHES/$name"
        [ -d "$dir" ] || continue
        kib="$(kib_of "$dir")"
        [ "${kib:-0}" -gt "$cap" ] || continue
        reason="$(human "$kib") > $(human "$cap")"
        if has_write_within "$dir" "$FLOOR_IDLE_MINUTES"; then
            note "over its cap but written in the last ${FLOOR_IDLE_MINUTES}m, kept: $dir ($reason)"
        elif [ "$dry" = 1 ]; then
            note "would delete $dir ($reason)"
        else
            keep="$(stage_settings "$dir" "$settings")"
            if evict "$dir" 1; then
                if [ -n "$keep" ]; then
                    cp -Rp "$keep"/. "$dir"/
                    rm -rf "$keep"
                    reason="$reason; its settings put back"
                fi
                note "deleted $dir ($reason); every checkout downloads into it again"
            else
                [ -z "$keep" ] || rm -rf "$keep"
                note "in use, kept: $dir ($reason)"
            fi
        fi
    done < <(shared_cache_entries)
}

# Is <root>'s checkout still a worktree whose build root is <root>?
checkout_is_live() {
    local root="$1" top
    [ -f "$root/.checkout" ] || return 1
    top="$(cat "$root/.checkout")"
    [ -d "$top" ] || return 1
    git -C "$top" rev-parse --show-toplevel >/dev/null 2>&1 || return 1
    [ "$(git -C "$top" rev-parse --show-toplevel)" = "$top" ] || return 1
    [ "$(build_root "$top")" = "$root" ]
}

all_roots() {
    local marker
    for marker in "$ROOT"/*/*/.checkout; do
        [ -f "$marker" ] && dirname "$marker"
    done
    return 0
}

free_kib() { df -k "$ROOT" | awk 'NR==2 { print $4 }'; }

# The build folders the floor may delete, as "<newest write> <folder>", least
# recently written first: every live checkout's but main's and the app
# checkout's.
floor_candidates() {
    local root top path _cap
    while IFS= read -r root; do
        checkout_is_live "$root" || continue
        keeps_warm "$root" && continue
        top="$(cat "$root/.checkout")"
        while read -r path _cap; do
            [ -d "$root/$path" ] && echo "$(newest_write "$root/$path") $root/$path"
        done < <(manifest_entries "$top")
    done < <(all_roots) | sort -n
}

# Brings the volume's free space up to the floor, waiting for each deletion
# so the next free-space reading counts it: the trash, the roots of checkouts
# that are gone, DerivedData's entries, then whole folders of the other
# checkouts, each least recently written first and only when nothing is using
# it or wrote to it lately. Main's and the app checkout's folders and the
# shared caches are never deleted here. When everything left is in use,
# freshly written or kept, it warns, naming the biggest folders, and fails
# only under the hard floor.
keep_floor() {
    local free when dir kib root
    free="$(free_kib)"
    [ "$free" -ge "$FLOOR_KIB" ] && return 0
    note "the build volume has $(human "$free") free, under the $(human "$FLOOR_KIB") floor; deleting idle DerivedData entries, then idle build folders outside main and the app checkouts, least recently written first"
    # Folders already renamed into the trash still hold their space until the
    # background removal finishes.
    if [ -d "$TRASH" ]; then
        rm -rf "$TRASH" 2>/dev/null || true
        free="$(free_kib)"
    fi
    while IFS= read -r root; do
        [ "$free" -ge "$FLOOR_KIB" ] && break
        checkout_is_live "$root" && continue
        kib="$(kib_of "$root")"
        if evict "$root" 0 1; then
            note "deleted $root ($(human "${kib:-0}"); its checkout is gone)"
            free="$(free_kib)"
        fi
    done < <(all_roots)
    while read -r when dir; do
        [ "$free" -ge "$FLOOR_KIB" ] && break
        has_write_within "$dir" "$FLOOR_IDLE_MINUTES" && continue
        kib="$(kib_of "$dir")"
        if evict "$dir" 0 1; then
            note "deleted $dir ($(human "${kib:-0}"), last write $(date -r "${when:-0}" '+%Y-%m-%d %H:%M')), a DerivedData entry"
            free="$(free_kib)"
        else
            note "in use, kept: $dir"
        fi
    done < <(derived_data_entries)
    while read -r when dir; do
        [ "$free" -ge "$FLOOR_KIB" ] && break
        kib="$(kib_of "$dir")"
        [ "${kib:-0}" -gt 1024 ] || continue
        has_write_within "$dir" "$FLOOR_IDLE_MINUTES" && continue
        if evict "$dir" 1 1; then
            note "deleted $dir ($(human "$kib"), last write $(date -r "${when:-0}" '+%Y-%m-%d %H:%M')); its next build refills it"
            free="$(free_kib)"
        else
            note "in use, kept: $dir"
        fi
    done < <(floor_candidates)
    [ "$free" -ge "$FLOOR_KIB" ] && return 0
    local hard=0
    [ "$free" -lt "$HARD_FLOOR_KIB" ] && hard=1
    {
        if [ "$hard" = 1 ]; then
            echo "builds: the build volume has $(human "$free") free, under the $(human "$HARD_FLOOR_KIB") hard floor, so this build stops before it starts."
        else
            echo "builds: warning: the build volume has $(human "$free") free, under the $(human "$FLOOR_KIB") floor; the build goes on, and under $(human "$HARD_FLOOR_KIB") builds stop."
        fi
        echo "Every build folder and DerivedData entry left is in use, was written in the last ${FLOOR_IDLE_MINUTES}m, or is main's or an app checkout's, which stay warm. The biggest the floor may delete:"
        floor_candidates | while read -r _when dir; do
            echo "$(kib_of "$dir") $dir"
        done | sort -rn | head -8 | while read -r kib dir; do
            echo "    $(human "$kib")  $dir"
        done
        if [ -d "$DERIVED_DATA" ]; then
            echo "    $(human "$(kib_of "$DERIVED_DATA")")  $DERIVED_DATA (entries in use or written lately)"
        fi
        echo "Kept warm:"
        all_roots | while IFS= read -r root; do
            if checkout_is_live "$root" && keeps_warm "$root"; then
                echo "    $(human "$(kib_of "$root")")  $root"
            fi
        done
        echo "Shared caches, which only their caps delete:"
        shared_cache_entries | while read -r name _cap _link _settings; do
            if [ -d "$CACHES/$name" ]; then
                echo "    $(human "$(kib_of "$CACHES/$name")")  $CACHES/$name"
            fi
        done
        echo "Retire finished side worktrees (builds retire), or delete idle build folders (builds prune --idle <minutes>)."
    } >&2
    [ "$hard" = 1 ] || return 0
    REPORTED=1
    exit 1
}

cmd_prune() {
    local dry=0 idle=0 warm=0 root top
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1; shift ;;
            --include-warm) warm=1; shift ;;
            --idle)
                case "${2:-}" in ''|*[!0-9]*) die "prune: --idle takes minutes" ;; esac
                idle="$2"; shift 2 ;;
            *) die "prune: unknown option $1" ;;
        esac
    done
    [ "$warm" = 0 ] || [ "$idle" -gt 0 ] || die "prune: --include-warm needs --idle"
    require_volume
    while IFS= read -r root; do
        top="$(cat "$root/.checkout")"
        if ! checkout_is_live "$root"; then
            if [ "$dry" = 1 ]; then
                note "would delete $root (checkout $top is gone)"
            elif evict "$root" 0; then
                note "deleted $root (checkout $top is gone)"
            else
                note "checkout $top is gone but $root is in use, kept"
            fi
            continue
        fi
        if [ "$warm" = 0 ] && keeps_warm "$root"; then
            prune_root "$root" "$top" "$dry" 0
        else
            prune_root "$root" "$top" "$dry" "$idle"
        fi
    done < <(all_roots)
    if [ "$idle" -gt 0 ] && [ "$idle" -lt "$DERIVED_DATA_IDLE_MINUTES" ]; then
        prune_derived_data "$dry" "$idle"
    else
        prune_derived_data "$dry" "$DERIVED_DATA_IDLE_MINUTES"
    fi
    prune_caches "$dry"
    prune_test_temps "$dry"
    prune_temp_builds "$dry"
    prune_scratchpads "$dry"
    prune_cargo_git "$dry"
    if [ "$dry" = 0 ]; then
        empty_trash
    fi
}

# ── Recording use ───────────────────────────────────────────────────────────

# Runs cargo with these arguments plus the flag that has it report every unit
# it uses on stdout, which record-use reads. Exits with cargo's status, or
# record-use's when cargo succeeded and a reported unit could not be recorded.
cmd_cargo() {
    local subcommand=() format statuses
    case "${1:-}" in
        build|check|clippy|doc|rustc|rustdoc|test|bench|run|install)
            subcommand=("$1")
            format=--message-format=json-render-diagnostics
            ;;
        nextest)
            case "${2:-}" in
                run|list|archive) subcommand=("$1" "$2") ;;
                *) die "cargo: cargo nextest ${2:-} builds nothing; run it without builds" ;;
            esac
            format=--cargo-message-format=json-render-diagnostics
            ;;
        '') die "usage: builds cargo <subcommand> [<args>...]" ;;
        *) die "cargo: cargo $1 builds nothing; run it without builds" ;;
    esac
    shift "${#subcommand[@]}"
    set +e
    cargo "${subcommand[@]}" "$format" "$@" | python3 "$UNITS" record
    statuses=("${PIPESTATUS[@]}")
    set -e
    # cargo and the recorder print their own failures.
    REPORTED=1
    [ "${statuses[0]}" = 0 ] || exit "${statuses[0]}"
    exit "${statuses[1]}"
}

cmd_record_use() {
    [ $# -eq 0 ] || die "usage: cargo ... --message-format=json-render-diagnostics | builds record-use"
    exec python3 "$UNITS" record
}

# ── Status ──────────────────────────────────────────────────────────────────

newest_write() {
    find "$1" -maxdepth 2 -print0 2>/dev/null \
        | xargs -0 stat -f '%m' 2>/dev/null | sort -n | tail -1
}

# Prints epoch time <when> for status; "-" for none (an empty folder).
last_write() {
    if [ "${1:-0}" = 0 ]; then echo -; else date -r "$1" '+%Y-%m-%d %H:%M'; fi
}

# Prints <entry> (a path on the volume) as UNKNOWN, with its size.
status_unknown() {
    printf '%s  %s  UNKNOWN: builds made nothing here\n' "${1#"$ROOT"/}" "$(human "$(kib_of "$1")")"
}

status_root() {
    local root="$1" top path cap kib when state total
    top="$(cat "$root/.checkout")"
    if checkout_is_live "$root"; then
        state="$(git -C "$top" branch --show-current 2>/dev/null)"
        state="${state:-detached}"
        if [ "$(basename "$root")" != main ] && keeps_warm "$root"; then
            state="$state, app checkout"
        fi
        if [ -f "$(claim_file "$top")" ]; then
            state="$state, claimed by $(claim_text "$top")"
        fi
        echo "${root#"$ROOT"/}  $top  [$state]"
    else
        echo "${root#"$ROOT"/}  $top  [checkout gone: prune deletes this root]"
        echo "    $(human "$(kib_of "$root")") total"
        return 0
    fi
    total=0
    while read -r path cap; do
        if [ ! -d "$root/$path" ]; then
            printf '    %-34s %8s / %-6s  (no folder)\n' "$path" - "$(human "$cap")"
            continue
        fi
        kib="$(kib_of "$root/$path")"
        total=$(( total + kib ))
        when="$(newest_write "$root/$path")"
        if [ "$kib" -gt "$cap" ]; then state="OVER CAP"; else state=""; fi
        printf '    %-34s %8s / %-6s  last write %s  %s\n' "$path" "$(human "$kib")" \
            "$(human "$cap")" "$(last_write "$when")" "$state"
        if [ -L "$top/$path" ]; then
            [ "$(absolute_link_target "$top/$path")" = "$root/$path" ] \
                || echo "      link points elsewhere: $(readlink "$top/$path")"
        else
            echo "      not linked: run builds setup $top"
        fi
    done < <(manifest_entries "$top")
    echo "    $(human "$total") total"
}

# Is <dir> a repo's folder: checkout roots, its app checkout's name or lock?
is_repo_dir() {
    local marker
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    [ -f "$1/app-checkout" ] || [ -f "$1/app.lock" ] && return 0
    for marker in "$1"/*/.checkout; do
        [ -f "$marker" ] && return 0
    done
    return 1
}

status_repo() {
    local dir="$1" entry
    for entry in "$dir"/* "$dir"/.[!.]*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        case "$(basename "$entry")" in
            app-checkout|app.lock) [ -f "$entry" ] && continue ;;
        esac
        if [ -d "$entry" ] && [ ! -L "$entry" ] && [ -f "$entry/.checkout" ]; then
            status_root "$entry"
        else
            status_unknown "$entry"
        fi
    done
}

status_derived_data() {
    local cap kib when entry newest=0 state="" xcode
    cap="$(cap_kib "$DERIVED_DATA_CAP" DerivedData)"
    kib="$(kib_of "$DERIVED_DATA")"
    while read -r when _entry; do
        newest="$when"
    done < <(derived_data_entries)
    [ "$kib" -gt "$cap" ] && state="OVER CAP"
    printf '%-38s %8s / %-6s  last write %s  %s\n' "DerivedData (Xcode's default)" \
        "$(human "$kib")" "$(human "$cap")" "$(last_write "$newest")" "$state"
    while read -r when entry; do
        printf '    %-34s %8s           last write %s\n' "$(basename "$entry")" \
            "$(human "$(kib_of "$entry")")" "$(last_write "$when")"
    done < <(derived_data_entries)
    xcode="$(defaults read com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || true)"
    if [ "$xcode" != "$DERIVED_DATA" ]; then
        echo "    Xcode's default DerivedData is ${xcode:-~/Library/Developer/Xcode/DerivedData}, not this: run builds install"
    fi
}

status_caches() {
    local name cap link dir kib when state entry known=" "
    echo "caches  (shared by every checkout)"
    while read -r name cap link _settings; do
        known="$known$name "
        dir="$CACHES/$name"
        if [ ! -d "$dir" ]; then
            printf '    %-34s %8s / %-6s  (no folder: run builds install)\n' "$name" - "$(human "$cap")"
        else
            kib="$(kib_of "$dir")"
            when="$(newest_write "$dir")"
            if [ "$name" = sccache ] \
                && [ "$(cat "$SCCACHE_CONFIG" 2>/dev/null)" != "$(sccache_config "$cap")" ]; then
                state="CONFIG DIFFERS: ${SCCACHE_CONFIG/#"$HOME"/~} does not hold this cap; run builds install"
            elif [ "$name" = sccache ]; then
                state="(sccache keeps it under its own cap)"
            elif [ "$kib" -gt "$cap" ]; then
                state="OVER CAP"
            else
                state=""
            fi
            printf '    %-34s %8s / %-6s  last write %s  %s\n' "$name" "$(human "$kib")" \
                "$(human "$cap")" "$(last_write "$when")" "$state"
        fi
        if [ -L "$link" ]; then
            [ "$(absolute_link_target "$link")" = "$dir" ] \
                || echo "      ${link/#"$HOME"/~} points elsewhere: $(readlink "$link")"
        elif [ -e "$link" ]; then
            echo "      ${link/#"$HOME"/~} is a real directory, not a link here: run builds install"
        else
            echo "      ${link/#"$HOME"/~} is missing: run builds install"
        fi
    done < <(shared_cache_entries)
    for entry in "$CACHES"/* "$CACHES"/.[!.]*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        case "$known" in *" $(basename "$entry") "*) continue ;; esac
        status_unknown "$entry"
    done
}

# Build output in the temporary folders, which belongs on the build volume.
status_temp_builds() {
    local folder when state
    while IFS= read -r folder; do
        when="$(newest_write "$folder")"
        if has_write_within "$folder" "$FLOOR_IDLE_MINUTES"; then
            state="written in the last ${FLOOR_IDLE_MINUTES}m"
        else
            state="prune deletes it"
        fi
        printf 'temp build output  %s  %s  last write %s  (%s)\n' "$folder" \
            "$(human "$(kib_of "$folder")")" "$(last_write "$when")" "$state"
    done < <(temp_build_folders)
}

# Every entry at the volume's root but macOS's own.
cmd_status() {
    local entry
    require_volume
    for entry in "$ROOT"/* "$ROOT"/.[!.]*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        case "$SYSTEM_ENTRIES" in *" $(basename "$entry") "*) continue ;; esac
        if [ "$entry" = "$TRASH" ] && [ -d "$entry" ]; then
            if [ -n "$(ls -A "$TRASH")" ]; then
                echo ".trash  $(human "$(kib_of "$TRASH")")  (deletions finishing in the background)"
            fi
        elif [ "$entry" = "$DERIVED_DATA" ] && [ -d "$entry" ]; then
            status_derived_data
        elif [ "$entry" = "$CACHES" ] && [ -d "$entry" ]; then
            status_caches
        elif is_repo_dir "$entry"; then
            status_repo "$entry"
        else
            status_unknown "$entry"
        fi
    done
    status_temp_builds
    [ -d "$DERIVED_DATA" ] || echo "DerivedData  (no folder: run builds install)"
    [ -d "$CACHES" ] || echo "caches  (no folder: run builds install)"
    # --show-stats would start a server if none is listening; only ask a
    # running one.
    if lsof -nP -iTCP:4226 -sTCP:LISTEN >/dev/null 2>&1; then
        sccache --show-stats 2>/dev/null \
            | grep -E '^(Cache location|Cache size|Max cache size)' | sed 's/^/sccache: /' || true
    fi
    df -h "$ROOT" | awk 'NR==2 { print "volume: " $4 " free of " $2 }'
}

# ── New / retire ────────────────────────────────────────────────────────────

cmd_new() {
    local repo_path="." branch="" who="" main repo parent n dir hook
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--branch) branch="$2"; shift 2 ;;
            --for) who="$2"; shift 2 ;;
            -*) die "new: unknown option $1" ;;
            *) repo_path="$1"; shift ;;
        esac
    done
    require_volume
    main="$(main_checkout "$(checkout_top "$repo_path")")"
    repo="$(basename "$main")"
    parent="$(dirname "$main")/$repo-worktrees"
    n=1
    while [ -e "$parent/side-$n" ] || [ -e "$ROOT/$repo/side-$n" ]; do
        n=$(( n + 1 ))
    done
    dir="$parent/side-$n"
    mkdir -p "$parent"
    git -C "$main" fetch -q origin
    # The hooks the common .git points at may belong to another checkout; this
    # one's own post-checkout runs below, after its build paths are linked.
    if [ -n "$branch" ]; then
        git -C "$main" -c core.hooksPath=/dev/null worktree add -q -b "$branch" "$dir" origin/main
    else
        git -C "$main" -c core.hooksPath=/dev/null worktree add -q --detach "$dir" origin/main
    fi
    cmd_setup "$dir"
    if [ -x "$dir/scripts/install-hooks.sh" ]; then
        (cd "$dir" && ./scripts/install-hooks.sh >/dev/null)
    fi
    hook="$dir/scripts/hooks/post-checkout"
    if [ -x "$hook" ]; then
        (cd "$dir" && "$hook" 0000000000000000000000000000000000000000 "$(git rev-parse HEAD)" 1)
    fi
    [ -z "$who" ] || write_claim "$dir" "$who"
    echo "$dir"
}

# ── Claims ──────────────────────────────────────────────────────────────────

claim_file() { echo "$(git -C "$1" rev-parse --absolute-git-dir)/builds-claim"; }

# "<who> since <date>" for the side worktree at <top>.
claim_text() {
    local who since
    IFS=$'\t' read -r who since < "$(claim_file "$1")"
    echo "$who since $since"
}

write_claim() {
    printf '%s\t%s\n' "$2" "$(date '+%Y-%m-%d %H:%M')" > "$(claim_file "$1")"
}

cmd_claim() {
    local top who held
    [ $# -eq 2 ] || die "usage: builds claim <checkout> <who>"
    top="$(checkout_top "$1")"
    who="$2"
    [ "$top" != "$(main_checkout "$top")" ] || die "$top is the main checkout; only side worktrees are claimed"
    if [ -f "$(claim_file "$top")" ]; then
        IFS=$'\t' read -r held _ < "$(claim_file "$top")"
        [ "$held" = "$who" ] || die "$top is claimed by $(claim_text "$top"); builds release it first if that work is over"
    fi
    write_claim "$top" "$who"
    note "claimed $top for $who"
}

cmd_release() {
    local top file
    [ $# -eq 1 ] || die "usage: builds release <checkout>"
    top="$(checkout_top "$1")"
    file="$(claim_file "$top")"
    [ -f "$file" ] || { note "$top has no claim"; return 0; }
    note "released $top (was $(claim_text "$top"))"
    rm "$file"
}

cmd_retire() {
    local top main root repo
    [ $# -eq 1 ] || die "usage: builds retire <checkout>"
    top="$(checkout_top "$1")"
    main="$(main_checkout "$top")"
    [ "$top" != "$main" ] || die "$top is the main checkout; only side worktrees retire"
    repo="$(repo_name "$top")"
    if [ "$(checkout_name "$top")" = "$(app_checkout_of "$repo")" ]; then
        die "$top is $repo's app checkout; record another with builds app-checkout, or delete $(app_checkout_file "$repo"), first"
    fi
    root="$(build_root "$top")"
    if [ -f "$(claim_file "$top")" ]; then
        die "$top is claimed by $(claim_text "$top"); builds release it first"
    fi
    if [ -n "$(git -C "$top" status --porcelain)" ]; then
        die "$top has uncommitted or untracked files; commit or remove them first"
    fi
    git -C "$main" worktree remove "$top"
    if [ -d "$root" ]; then
        evict "$root" 0 \
            || die "worktree removed, but a process holds files in $root; run builds prune once it exits"
    fi
    note "retired $top and deleted $root"
}

# Records side worktree <checkout> as its repo's app checkout, replacing the
# one recorded before.
cmd_app_checkout() {
    local top repo name file
    [ $# -eq 1 ] || die "usage: builds app-checkout <checkout>"
    top="$(checkout_top "$1")"
    [ "$top" != "$(main_checkout "$top")" ] \
        || die "$top is the main checkout, which keeps its builds warm already; the app checkout is a side worktree"
    require_volume
    require_repo_name "$top"
    repo="$(repo_name "$top")"
    name="$(checkout_name "$top")"
    file="$(app_checkout_file "$repo")"
    mkdir -p "$ROOT/$repo"
    printf '%s\n' "$name" > "$file"
    note "recorded $top as $repo's app checkout in $file; the free-space floor keeps its folders"
}

# ── Install ─────────────────────────────────────────────────────────────────

SCCACHE_LABEL=local.sccache-server

# Writes stdin to <file> unless <file> already holds exactly that; returns 1,
# writing nothing, when it does.
write_if_changed() {
    local file="$1" content
    content="$(cat)"
    if [ -f "$file" ] && [ "$(cat "$file")" = "$content" ]; then
        return 1
    fi
    printf '%s\n' "$content" > "$file"
}

# Makes <link> (~/.gradle) a symlink to the shared cache <dir> on the volume.
# A real directory there, from a tool that ran before the link existed, is
# moved onto the volume whole, since it may hold the tool's own settings
# (~/.gradle/gradle.properties, ~/.nuget/NuGet/NuGet.Config) beside the cache.
link_cache() {
    local dir="$1" link="$2" shown="${2/#"$HOME"/~}"
    if [ -L "$link" ]; then
        [ "$(absolute_link_target "$link")" = "$dir" ] \
            || die "$shown points at $(readlink "$link"), not $dir; move what it holds into $dir, remove the link, and run builds install again"
        mkdir -p "$dir"
        return 0
    fi
    if [ -e "$link" ]; then
        [ ! -e "$dir" ] \
            || die "both $shown and $dir exist; move what you need from $shown into $dir, remove $shown, and run builds install again"
        note "moving $shown to $dir"
        mv "$link" "$dir"
    else
        mkdir -p "$dir" "$(dirname "$link")"
    fi
    ln -s "$dir" "$link"
    note "linked $shown -> $dir"
}

# The sccache config file, which sccache reads on every client and server
# start, whatever the caller's environment, so the cap holds for builds that
# never source a shell profile; and the text `install` writes there for a cap
# of $1 KiB.
SCCACHE_CONFIG="$HOME/Library/Application Support/Mozilla.sccache/config"
sccache_config() {
    cat <<EOF
# Written by builds install ($SELF).
[cache.disk]
size = $(( $1 * 1024 ))
EOF
}

cmd_install() {
    local sccache_bin config_dir plist name cap link sccache_kib="" restart=0 xcode
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$SELF" "$HOME/.local/bin/builds"
    note "linked ~/.local/bin/builds -> $SELF"

    require_volume
    mkdir -p "$CACHES" "$DERIVED_DATA"
    while read -r name cap link _settings; do
        link_cache "$CACHES/$name" "$link"
        [ "$name" = sccache ] && sccache_kib="$cap"
    done < <(shared_cache_entries)
    [ -n "$sccache_kib" ] || die "the shared caches list no sccache cache"

    sccache_bin="$(command -v sccache)" || die "sccache is not installed"
    config_dir="$(dirname "$SCCACHE_CONFIG")"
    mkdir -p "$config_dir"
    if sccache_config "$sccache_kib" | write_if_changed "$SCCACHE_CONFIG"
    then
        note "wrote $SCCACHE_CONFIG ($(human "$sccache_kib") cache)"
        restart=1
    fi

    # One server on sccache's default TCP port, started with the system
    # TMPDIR: a server inherits the TMPDIR of whichever client starts it, and a
    # session-scoped TMPDIR deleted later fails every compile. launchd starts
    # it at login, restarts it if it exits, and it never idles out, so no
    # client has a reason to start one of its own. SCCACHE_START_SERVER=1 makes
    # this process the server and SCCACHE_NO_DAEMON=1 keeps it from forking, so
    # it is the process launchd watches (`--start-server` forks the server off,
    # and the server daemonizes itself without NO_DAEMON). launchd starts a job
    # at 256 open files; the server holds every source file it hashes open, and
    # a crate like aws-sdk-s3 runs out at that, so the job raises its own limit.
    plist="$HOME/Library/LaunchAgents/$SCCACHE_LABEL.plist"
    if write_if_changed "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by builds install ($SELF). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$SCCACHE_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>TMPDIR="\$(getconf DARWIN_USER_TEMP_DIR)" exec "$sccache_bin"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCCACHE_START_SERVER</key>
    <string>1</string>
    <key>SCCACHE_NO_DAEMON</key>
    <string>1</string>
    <key>SCCACHE_IDLE_TIMEOUT</key>
    <string>0</string>
    <key>SCCACHE_ERROR_LOG</key>
    <string>$HOME/Library/Logs/sccache-server.log</string>
  </dict>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF
    then
        note "wrote $plist"
        restart=1
    fi
    # Restarting the server fails the compiles of every build running now, so
    # it restarts only when its settings changed or launchd isn't running it.
    if [ "$restart" = 1 ] || ! launchctl print "gui/$(id -u)/$SCCACHE_LABEL" >/dev/null 2>&1; then
        launchctl bootout "gui/$(id -u)/$SCCACHE_LABEL" 2>/dev/null || true
        "$sccache_bin" --stop-server >/dev/null 2>&1 || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
        note "started the sccache server under launchd ($plist)"
    else
        note "the sccache server already runs under launchd with these settings"
    fi

    # xcodebuild runs without -derivedDataPath, and the Xcode app, write here.
    xcode="$(defaults read com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || true)"
    if [ "$xcode" != "$DERIVED_DATA" ]; then
        defaults write com.apple.dt.Xcode IDECustomDerivedDataLocation -string "$DERIVED_DATA"
        note "pointed Xcode's default DerivedData at $DERIVED_DATA (was ${xcode:-~/Library/Developer/Xcode/DerivedData}); a running Xcode uses it once relaunched"
    fi
}

# ── Dispatch ────────────────────────────────────────────────────────────────

[ $# -ge 1 ] || { sed -n '2,/^$/s/^# \{0,1\}//p' "$SELF"; REPORTED=1; exit 2; }
command="$1"
shift
case "$command" in
    setup) cmd_setup "$@" ;;
    new) cmd_new "$@" ;;
    retire) cmd_retire "$@" ;;
    claim) cmd_claim "$@" ;;
    release) cmd_release "$@" ;;
    app-checkout) cmd_app_checkout "$@" ;;
    status) cmd_status "$@" ;;
    prune) cmd_prune "$@" ;;
    install) cmd_install "$@" ;;
    cargo) cmd_cargo "$@" ;;
    record-use) cmd_record_use "$@" ;;
    -h|--help|help) sed -n '2,/^$/s/^# \{0,1\}//p' "$SELF" ;;
    *) die "unknown command $command (setup | new | claim | release | retire | app-checkout | status | prune | cargo | record-use | install)" ;;
esac
