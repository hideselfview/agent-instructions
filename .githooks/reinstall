#!/usr/bin/env bash
# Re-runs the main checkout's install.sh when the commits in <range> touch
# anything it consumes, including the builds, boards and shots sources that
# it builds into the installed builds and builds-shots, so generated
# instruction files, symlinks and the installed tools stay current without a
# manual install. Only for what reaches main: install.sh
# links the main checkout's files as the live config and builds builds from
# its HEAD, so it runs only in the main checkout while its branch is main. A
# commit on a side worktree's branch installs nothing; it goes live once it
# lands and the main checkout's main moves to it.

set -euo pipefail

main="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
[ "$(git rev-parse --show-toplevel)" = "$main" ] || exit 0
[ "$(git symbolic-ref -q --short HEAD)" = main ] || exit 0

if git diff --name-only "$@" \
  | grep -qE '^(instructions-agent\.md|generate\.py|install\.sh|claude/(settings\.json|skills/.+)|codex/(config\.toml|skills/.+)|((rules|projects)/.+\.md)|scripts/(builds|boards|shots)/.+)$'; then
  exec "$main/install.sh"
fi
