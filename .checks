# The checks `builds checks run` runs on a commit's staged files
# (`builds help checks`).
#
#   <kind> <name> <paths> <program> [args...]
#
# kind: `check` (static check), `whole` (a check of the whole tree, which
# `builds land` also runs on every landing) or `fix` (formatter; builds
# re-stages what it changed). paths: the files the line reads, as comma-separated globs.
# `{files}` is the staged files that match. Formatting and static analysis
# only: no tests.

# Markdown; width and the other options come from .mdformat.toml
fix mdformat *.md mdformat {files}

# builds' Rust and the library it shares; the edition is the crates' (rustfmt
# alone assumes 2015). builds compiles the library, so a change to it checks
# both.
fix rustfmt scripts/builds/**/*.rs,scripts/boards/**/*.rs rustfmt --edition 2024 {files}
check clippy scripts/builds/**/*.rs,scripts/builds/Cargo.toml,scripts/builds/Cargo.lock,scripts/boards/**/*.rs,scripts/boards/Cargo.toml cargo clippy --manifest-path scripts/builds/Cargo.toml --all-targets -- -D warnings
check clippy-boards scripts/boards/**/*.rs,scripts/boards/Cargo.toml,scripts/boards/Cargo.lock cargo clippy --manifest-path scripts/boards/Cargo.toml --all-targets -- -D warnings

# Shell, at warning level
check shellcheck *.sh,.githooks/* shellcheck -S warning {files}
