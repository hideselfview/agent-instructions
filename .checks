# The checks `builds checks run` runs on a commit's staged files
# (`builds help checks`).
#
#   <kind> <name> <paths> <program> [args...]
#
# kind: `check` (static check), `whole` (a check of the whole tree, which
# `builds land` also runs on every landing) or `fix` (formatter; builds
# re-stages what it changed). paths: the files the line reads, as comma-separated globs.
# `{files}` is the staged files that match. Formatting and static analysis
# only: no tests.

# Markdown; width and the other options come from .mdformat.toml
fix mdformat *.md mdformat {files}

# builds' Rust and the libraries it is built with, the boards library and the
# shots checker; the edition is the crates' (rustfmt alone assumes 2015).
# builds compiles both libraries and the shots checker compiles the boards
# library, so a change to a library checks each crate that compiles it.
fix rustfmt scripts/builds/**/*.rs,scripts/boards/**/*.rs,scripts/shots/**/*.rs rustfmt --edition 2024 {files}
check clippy scripts/builds/**/*.rs,scripts/builds/**/*.sql,scripts/builds/Cargo.toml,scripts/builds/Cargo.lock,scripts/builds/clippy.toml,scripts/boards/**/*.rs,scripts/boards/Cargo.toml,scripts/shots/**/*.rs,scripts/shots/Cargo.toml,scripts/shots/canvas/*,scripts/shots/harness/** cargo clippy --manifest-path scripts/builds/Cargo.toml --all-targets -- -D warnings
check clippy-boards scripts/boards/**/*.rs,scripts/boards/Cargo.toml,scripts/boards/Cargo.lock,scripts/boards/runtime/* cargo clippy --manifest-path scripts/boards/Cargo.toml --all-targets -- -D warnings
check clippy-shots scripts/shots/**/*.rs,scripts/shots/Cargo.toml,scripts/shots/Cargo.lock,scripts/shots/canvas/*,scripts/shots/harness/**,scripts/boards/**/*.rs,scripts/boards/Cargo.toml,scripts/boards/runtime/* cargo clippy --manifest-path scripts/shots/Cargo.toml --all-targets -- -D warnings

# The Swift and the Kotlin of the shots checker's harnesses;
# scripts/shots/.swift-format and scripts/shots/.editorconfig hold the styles.
fix swift-format scripts/shots/**/*.swift xcrun swift-format format -i -p {files}
check swift-format-lint scripts/shots/**/*.swift xcrun swift-format lint -s {files}
fix ktlint-format scripts/shots/**/*.kt ktlint -F {files}
check ktlint scripts/shots/**/*.kt ktlint {files}

# Shell, at warning level
check shellcheck *.sh,.githooks/* shellcheck -S warning {files}
