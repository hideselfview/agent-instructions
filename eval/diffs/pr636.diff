+/// Replace `album_artists` rows for `album_id`. Shared by every path
+/// that writes a full artist list for an album so the schema can only
+/// drift in one place.
+async fn replace_album_artists(
+    conn: &mut sqlx::SqliteConnection,
+    album_id: &str,
+    artists: &[DbAlbumArtist],
+    now: &str,
+) -> Result<(), sqlx::Error> {
+    sqlx::query("DELETE FROM album_artists WHERE album_id = ?")
+        .bind(album_id)
+        .execute(&mut *conn)
+        .await?;
+    for aa in artists {
+        sqlx::query(
+            r#"INSERT INTO album_artists (id, album_id, artist_id, position, _updated_at, created_at)
+            VALUES (?, ?, ?, ?, ?, ?)"#,
+        )
+        .bind(&aa.id)
+        .bind(album_id)
+        .bind(&aa.artist_id)
+        .bind(aa.position)
+        .bind(now)
+        .bind(now)
+        .execute(&mut *conn)
+        .await?;
+    }
+    Ok(())
+}
+
+/// Replace `track_artists` rows for every id in `track_ids`, then
+/// insert the new rows. Callers pass the affected track ids explicitly
+/// because `artists` may not cover every track (a track legitimately
+/// has no per-track artists when it inherits from the album).
+async fn replace_track_artists(
+    conn: &mut sqlx::SqliteConnection,
+    track_ids: &[&str],
+    artists: &[DbTrackArtist],
+    now: &str,
+) -> Result<(), sqlx::Error> {
+    for track_id in track_ids {
+        sqlx::query("DELETE FROM track_artists WHERE track_id = ?")
+            .bind(track_id)
+            .execute(&mut *conn)
+            .await?;
+    }
+    for ta in artists {
+        sqlx::query(
+            r#"INSERT INTO track_artists (id, track_id, artist_id, position, role, _updated_at, created_at)
+            VALUES (?, ?, ?, ?, ?, ?, ?)"#,
+        )
+        .bind(&ta.id)
+        .bind(&ta.track_id)
+        .bind(&ta.artist_id)
+        .bind(ta.position)
+        .bind(&ta.role)
+        .bind(now)
+        .bind(now)
+        .execute(&mut *conn)
+        .await?;
+    }
+    Ok(())
+}
