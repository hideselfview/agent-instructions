+    /// Apply a user metadata edit (A7) to an existing release in a single
+    /// transaction.
+    ///
+    /// Distinct from `update_release_metadata`, which is the search-and-
+    /// replace path used after re-fetching from MB/Discogs. This one is for
+    /// the user-edited values produced by the EditMetadataSheet:
+    ///
+    /// - Updates album-level fields, release pressing fields, and track
+    ///   metadata.
+    /// - Replaces `album_artists` and `track_artists` rows for the affected
+    ///   album/tracks.
+    /// - Does NOT touch `release_metadata` rows — the cached source payload
+    ///   stays put so A9 reset can re-project from it.
+    /// - Does NOT touch `release_identities`, `metadata_source`, or
+    ///   `metadata_source_release_id` — identity is orthogonal to metadata.
+    ///
+    /// `track_updates` maps existing track IDs to their edited rows.
+    #[allow(clippy::too_many_arguments)]
+    pub async fn update_release_metadata_user_edit(
+        &self,
+        album_id: &str,
+        release_id: &str,
+        album: &DbAlbum,
+        release: &DbRelease,
+        track_updates: &[(String, DbTrack)],
+        album_artists: &[DbAlbumArtist],
+        track_artists: &[DbTrackArtist],
+    ) -> Result<(), sqlx::Error> {
+        let mut conn = self.writer()?.lock().await;
+        let mut tx = conn.begin().await?;
+        let now = Utc::now().to_rfc3339();
+
+        // 1. Update album.
+        sqlx::query(
+            r#"UPDATE albums SET title = ?, artist_id = ?, year = ?, is_compilation = ?,
+            _updated_at = ? WHERE id = ?"#,
+        )
+        .bind(&album.title)
+        .bind(&album.artist_id)
+        .bind(album.year)
+        .bind(album.is_compilation)
+        .bind(&now)
+        .bind(album_id)
+        .execute(&mut *tx)
+        .await?;
+
+        // 2. Update release pressing fields.
+        sqlx::query(
+            r#"UPDATE releases SET year = ?, format = ?, label = ?, catalog_number = ?,
+            country = ?, barcode = ?, _updated_at = ? WHERE id = ?"#,
+        )
+        .bind(release.year)
+        .bind(&release.format)
+        .bind(&release.label)
+        .bind(&release.catalog_number)
+        .bind(&release.country)
+        .bind(&release.barcode)
+        .bind(&now)
+        .bind(release_id)
+        .execute(&mut *tx)
+        .await?;
+
+        // 3. Update tracks by existing ID.
+        for (existing_id, new_track) in track_updates {
+            sqlx::query(
+                r#"UPDATE tracks SET title = ?, side = ?, track_number = ?,
+                _updated_at = ? WHERE id = ?"#,
+            )
+            .bind(&new_track.title)
+            .bind(new_track.side)
+            .bind(new_track.track_number)
+            .bind(&now)
+            .bind(existing_id)
+            .execute(&mut *tx)
+            .await?;
+        }
+
+        // 4. Replace album_artists.
+        replace_album_artists(&mut tx, album_id, album_artists, &now).await?;
+
+        // 5. Replace track_artists for the affected tracks.
+        let track_ids: Vec<&str> = track_updates.iter().map(|(id, _)| id.as_str()).collect();
+        replace_track_artists(&mut tx, &track_ids, track_artists, &now).await?;
+
+        tx.commit().await?;
+        Ok(())
+    }
