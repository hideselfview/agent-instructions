@@ -0,0 +1,370 @@
+import SwiftUI
+
+// MARK: - EditMetadataValues
+
+/// Pure metadata payload the sheet edits. Mirrors the editable subset of
+/// `BridgeReleaseUserEdit` — what A7 is allowed to change for a release.
+///
+/// Used both as initial seed (load values into the form) and as save
+/// payload (read values back out). The sheet keeps a mutable copy as
+/// `@State` and hands the final version to its `onSave` callback.
+///
+/// `albumArtistText` is the literal text of the artist field — comma
+/// separates multiple artists, in author-positional order. `toBridge()`
+/// splits and trims at the boundary; the wire-level shape is a list.
+struct EditMetadataValues: Equatable {
+    var albumTitle: String
+    var albumArtistText: String
+    var year: Int32?
+    var format: String?
+    var label: String?
+    var catalogNumber: String?
+    var country: String?
+    var barcode: String?
+    var tracks: [TrackEdit]
+}
+
+/// One per existing track, in order. `artistText` empty means the track
+/// shares the album artist (no per-track artist rows written by the
+/// commit operation). Non-empty is comma-separated, positional — same
+/// shape as `EditMetadataValues.albumArtistText`.
+struct TrackEdit: Equatable, Identifiable {
+    /// Stable client-side identifier. For post-commit edits this is the
+    /// existing track's DB id; for pre-commit it's a fresh UUID. The
+    /// sheet doesn't care which — it only needs the value to be stable
+    /// across re-renders so SwiftUI can diff `ForEach` rows.
+    let id: String
+    var title: String
+    var artistText: String
+    var side: Int32
+    var trackNumber: Int32?
+}
+
+// MARK: - EditMetadataSheet
+
+/// Reusable editor for user-owned metadata changes (A7 in the release
+/// identity model). Used in three surfaces:
+///
+/// - **Post-commit** — invoked from the album / release detail "Edit
+///   metadata..." menu. Initial values come from the persisted release;
+///   `onSave` writes back via the user-edit commit operation.
+/// - **Pre-commit, Exact / Approximate** — invoked from the import
+///   confirmation page after the user picks a result. Initial values
+///   come from the picked release detail; `onSave` stashes the values
+///   so commit applies them on top of the source-seeded record.
+/// - **Pre-commit, Unknown** — invoked from the Add-as-Unknown flow.
+///   Initial values come from the file-tag projection (A10) plus
+///   signals; `onSave` stashes the values for commit.
+///
+/// The sheet is pure: it accepts initial values and emits the edited
+/// values via callbacks. Wiring per surface lives at the call site.
+///
+/// Identity is unaffected by edits — this sheet does not surface or
+/// modify `release_identities` rows or the `metadata_source` columns.
+struct EditMetadataSheet: View {
+    let onSave: (EditMetadataValues) async throws -> Void
+    let onCancel: () -> Void
+
+    @State
+    private var values: EditMetadataValues
+    @State
+    private var saving = false
+    @State
+    private var errorMessage: String?
+    @State
+    private var saveTask: Task<Void, Never>?
+
+    init(
+        initialValues: EditMetadataValues,
+        onSave: @escaping (EditMetadataValues) async throws -> Void,
+        onCancel: @escaping () -> Void,
+    ) {
+        self.onSave = onSave
+        self.onCancel = onCancel
+        _values = State(initialValue: initialValues)
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            header
+            Divider()
+            Form {
+                albumSection
+                pressingSection
+                tracksSection
+            }
+            .formStyle(.grouped)
+            .scrollContentBackground(.hidden)
+            if let errorMessage {
+                HStack(spacing: 6) {
+                    Image(systemName: "exclamationmark.triangle.fill")
+                    Text(errorMessage)
+                }
+                .font(.caption)
+                .foregroundStyle(.red)
+                .padding(.horizontal)
+                .padding(.bottom, 8)
+            }
+            footer
+        }
+        .frame(width: 640, height: 640)
+        .background(Theme.background)
+        .onDisappear {
+            saveTask?.cancel()
+        }
+    }
+
+    // MARK: - Header
+
+    private var header: some View {
+        HStack {
+            Text("Edit Metadata")
+                .font(.headline)
+            Spacer()
+            Button("Cancel") { onCancel() }
+                .keyboardShortcut(.cancelAction)
+                .disabled(saving)
+        }
+        .padding()
+    }
+
+    // MARK: - Album section
+
+    private var albumSection: some View {
+        Section("Album") {
+            TextField("Title", text: $values.albumTitle)
+            TextField("Artist (comma-separated)", text: $values.albumArtistText)
+        }
+    }
+
+    // MARK: - Pressing section
+
+    private var pressingSection: some View {
+        Section("Release pressing") {
+            optionalIntField("Year", value: $values.year)
+            optionalStringField("Format", value: $values.format)
+            optionalStringField("Label", value: $values.label)
+            optionalStringField("Catalog number", value: $values.catalogNumber)
+            optionalStringField("Country", value: $values.country)
+            optionalStringField("Barcode", value: $values.barcode)
+        }
+    }
+
+    // MARK: - Tracks section
+
+    private var tracksSection: some View {
+        Section("Tracks") {
+            if values.tracks.isEmpty {
+                Text("No tracks")
+                    .font(.callout)
+                    .foregroundStyle(.secondary)
+            }
+            else {
+                ForEach($values.tracks) { $track in
+                    trackRow(track: $track)
+                }
+            }
+        }
+    }
+
+    private func trackRow(track: Binding<TrackEdit>) -> some View {
+        VStack(alignment: .leading, spacing: 6) {
+            TextField("Title", text: track.title)
+            HStack(spacing: 8) {
+                TextField(
+                    "Artist (blank = album artist, comma-separated)",
+                    text: track.artistText
+                )
+                trackSideField(track: track)
+                trackNumberField(track: track)
+            }
+        }
+        .padding(.vertical, 2)
+    }
+
+    private func trackSideField(track: Binding<TrackEdit>) -> some View {
+        TextField(
+            "Disc/Side",
+            value: track.side,
+            format: .number
+        )
+        .frame(width: 70)
+    }
+
+    private func trackNumberField(track: Binding<TrackEdit>) -> some View {
+        TextField(
+            "Track #",
+            value: track.trackNumber,
+            format: .number
+        )
+        .frame(width: 70)
+    }
+
+    // MARK: - Footer
+
+    private var footer: some View {
+        HStack(spacing: 12) {
+            Spacer()
+            if saving {
+                ProgressView()
+                    .controlSize(.small)
+                Text("Saving...")
+                    .font(.callout)
+                    .foregroundStyle(.secondary)
+            }
+            else {
+                Button("Save") { triggerSave() }
+                    .buttonStyle(.borderedProminent)
+                    .keyboardShortcut(.defaultAction)
+                    .disabled(saveDisabled)
+            }
+        }
+        .padding()
+    }
+
+    private var saveDisabled: Bool {
+        values.albumTitle.trimmingCharacters(in: .whitespaces).isEmpty
+            || EditMetadataValues.splitArtists(values.albumArtistText).isEmpty
+    }
+
+    // MARK: - Actions
+
+    private func triggerSave() {
+        saveTask?.cancel()
+        errorMessage = nil
+        saving = true
+        let snapshot = values
+        saveTask = Task {
+            do {
+                try await onSave(snapshot)
+                saving = false
+            }
+            catch is CancellationError {
+                // Sheet dismissed mid-save; teardown owns the next transition.
+            }
+            catch {
+                saving = false
+                errorMessage = "Save failed: \(error.localizedDescription)"
+            }
+        }
+    }
+
+    // MARK: - Reusable optional-field wrappers
+
+    /// Optional `String?` field where empty input maps to `nil`. Avoids
+    /// the trap of writing an empty string into a column that means
+    /// "not set" — the apply layer enforces `Option<String>`, so the UI
+    /// must too. Trims on write so trailing whitespace never reaches the
+    /// wire.
+    private func optionalStringField(
+        _ label: String,
+        value: Binding<String?>,
+    ) -> some View {
+        let proxy = Binding<String>(
+            get: {
+                if let v = value.wrappedValue {
+                    return v
+                }
+                return ""
+            },
+            set: { newValue in
+                let trimmed = newValue.trimmingCharacters(in: .whitespaces)
+                value.wrappedValue = trimmed.isEmpty ? nil : trimmed
+            }
+        )
+        return TextField(label, text: proxy)
+    }
+
+    /// Optional `Int32?` field. Same nil-on-empty rule as
+    /// `optionalStringField`.
+    private func optionalIntField(
+        _ label: String,
+        value: Binding<Int32?>,
+    ) -> some View {
+        TextField(
+            label,
+            value: value,
+            format: .number.grouping(.never)
+        )
+    }
+}
+
+// MARK: - Initial-value seeding
+
+extension EditMetadataValues {
+    /// Seed from a library release that already exists. Used by the
+    /// post-commit surface (album / release detail "Edit metadata...").
+    init(release: ReleaseDetail, albumSummary: AlbumSummary) {
+        albumTitle = albumSummary.title
+        albumArtistText = albumSummary.artistNames
+        year = release.year
+        format = release.summary.format
+        label = release.label
+        catalogNumber = release.catalogNumber
+        country = release.country
+        barcode = release.barcode
+        tracks = release.tracks.map { track in
+            TrackEdit(
+                id: track.id,
+                title: track.title,
+                artistText: track.artistOverride ?? "",
+                side: track.side,
+                trackNumber: track.trackNumber
+            )
+        }
+    }
+
+    /// Split a comma-separated artist field into trimmed names, dropping
+    /// empties. Shared between the wire conversion and the form's
+    /// "save disabled" check so both apply the same rule.
+    static func splitArtists(_ raw: String) -> [String] {
+        raw.split(separator: ",", omittingEmptySubsequences: true)
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+    }
+}
+
+// MARK: - Bridge conversion
+
+extension EditMetadataValues {
+    /// Convert to the bridge type the post-commit save handler hands to
+    /// the user-edit commit operation. Trims and splits at the boundary
+    /// so the wire shape carries normalized lists, never raw form text.
+    func toBridge() -> BridgeReleaseUserEdit {
+        BridgeReleaseUserEdit(
+            albumTitle: albumTitle.trimmingCharacters(in: .whitespaces),
+            albumArtistNames: EditMetadataValues.splitArtists(albumArtistText),
+            year: year,
+            format: format,
+            label: label,
+            catalogNumber: catalogNumber,
+            country: country,
+            barcode: barcode,
+            tracks: tracks.map { t in
+                BridgeTrackUserEdit(
+                    title: t.title.trimmingCharacters(in: .whitespaces),
+                    side: t.side,
+                    trackNumber: t.trackNumber,
+                    artistNames: EditMetadataValues.splitArtists(t.artistText)
+                )
+            }
+        )
+    }
+}
+
+// MARK: - Previews
+
+#Preview("Edit Metadata — Post-commit") {
+    let store = LibraryStore()
+    store.handleAlbumAdded(album: PreviewData.albumDetails["a-01"]!)
+    let summary = store.albumSummaries["a-01"]!
+    let release = store.releaseDetails[summary.primaryReleaseId]!
+    return EditMetadataSheet(
+        initialValues: EditMetadataValues(
+            release: release,
+            albumSummary: summary
+        ),
+        onSave: { _ in },
+        onCancel: {},
+    )
+}
