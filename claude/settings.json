{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "allow": [
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(builds ack:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/builds\" agent start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/builds\" ack --compacted",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/builds\" agent start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/no-future-promises.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/no-full-suites.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/no-polling-loops.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/no-skipped-hooks-or-hard-resets.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/no-unlocked-app-checkout-moves.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/dev/agent-instructions/scripts/hooks/ack-part-bare.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer@agent-instructions": true
  },
  "extraKnownMarketplaces": {
    "agent-instructions": {
      "source": {
        "source": "directory",
        "path": "/Users/dima/dev/agent-instructions/claude/plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 550000
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "push to github, even to main"
    ]
  },
  "voiceEnabled": true
}
